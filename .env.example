# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Firebase Configuration
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id
PUBLIC_FIREBASE_MEASURMENT_ID=your_measurement_id

# OpenAI API (if needed for features)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# ImgBB Image Hosting API
PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here
