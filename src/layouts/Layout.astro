---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";

import "../styles/global.css";
import "../styles/fonts.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  hideChrome?: boolean;
  canonical?: string;
}

const {
  title = "Hydra Fox Designs | Web Design & Digital Marketing Agency",
  description = "Hydra Fox Designs helps businesses grow through creative web design, digital marketing, and automation solutions.",
  image = "/images/hfd-logo.png",
  noindex = false,
  hideChrome = false,
  canonical,
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/png" href="/images/hfd-logo.png" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics 4 — runs in Partytown Web Worker (off main thread) -->
    {import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID && (
      <>
        <script type="text/partytown" async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID}`}></script>
        <script type="text/partytown" set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID}');
        `}></script>
      </>
    )}

    <!-- Enable SPA-like smooth navigation -->
    <ClientRouter />

    <!-- Prevent white flash -->
    <style>
      html,
      body {
        background-color: #000000 !important;
        margin: 0;
        padding: 0;
      }
    </style>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <!-- Open Graph (Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Hydra Fox Designs" />

    <!-- Theme color -->
    <meta name="theme-color" content="#000000" />

    <!-- Performance: Resource Hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://stream.mux.com" />
    <link rel="dns-prefetch" href="https://firestore.googleapis.com" />

    <!-- Performance: Preload critical assets -->
    <link rel="preload" href="/images/hfd-logo-withoutBg.png" as="image" />

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="MRZjN0KQWpfi1av__c8T15nCsabgW72dLIzb6Qk8bys" />

    <!-- PWA: Web App Manifest (optional) -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hydrafoxdesigns" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data: ProfessionalService -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Hydra Fox Designs",
        url: "https://hydrafoxdesigns.com",
        logo: "https://hydrafoxdesigns.com/images/hfd-logo.png",
        description:
          "Hydra Fox Designs helps businesses grow through creative web design, digital marketing, branding, and automation solutions.",
        telephone: "+92-335-4345625",
        email: "muneerzameer@hydrafoxdesigns.com",
        areaServed: "Worldwide",
        serviceType: ["Branding", "Web Design", "Digital Marketing", "UX/UI Design"],
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "Services",
          itemListElement: [
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Branding" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Design" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Marketing" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Web Development" } },
          ],
        },
        sameAs: [
          "https://www.facebook.com/hydrafoxdesign",
          "https://www.instagram.com/official_hydra_fox/",
          "https://www.linkedin.com/company/hydrafox-designs/",
        ],
      })}
    />

    <slot name="head" />
  </head>

  <body class:list={[hideChrome ? "" : "pt-12 sm:pt-16 md:pt-0"]}>
    {!hideChrome && <Navbar client:load transition:persist />}

    <main>
      <slot />
    </main>

    {!hideChrome && <Footer transition:persist />}


    <!-- Service Worker Registration -->
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .then(() => {})
            .catch(() => {});
        });
      }
    </script>

    <!-- Global scroll-triggered reveal system -->
    <script>
      function initScrollReveals() {
        const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
        const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';
        document.querySelectorAll<HTMLElement>('.scroll-section').forEach(section => {
          if (section.dataset.revealed) return;
          const lines = section.querySelectorAll<HTMLElement>('.reveal-line');
          const fades = section.querySelectorAll<HTMLElement>('.reveal-fade');
          lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
          fades.forEach(el => { el.style.opacity = '0'; });
          let triggered = false;
          const observer = new IntersectionObserver(([entry]) => {
            if (entry.isIntersecting && !triggered) {
              triggered = true;
              section.dataset.revealed = 'true';
              lines.forEach((el, i) => {
                const anim = el.animate(
                  [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
                  { duration: 900, delay: i * 120, easing: EXPO_OUT, fill: 'forwards' }
                );
                anim.onfinish = () => { el.style.willChange = 'auto'; };
              });
              fades.forEach((el, i) => {
                const anim = el.animate(
                  [{ opacity: '0' }, { opacity: '1' }],
                  { duration: 700, delay: 200 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
                );
                anim.onfinish = () => { el.style.willChange = 'auto'; };
              });
              observer.disconnect();
            }
          }, { threshold: 0.15 });
          observer.observe(section);
        });
      }
      document.addEventListener('astro:page-load', initScrollReveals);
    </script>
  </body>
</html>

<style is:global>
  /* 
    Core global resets. 
    Typography and Colors are managed in src/styles/global.css 
  */

  * {
    box-sizing: border-box;
  }

  html {
    background: #000000;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: #000000;
    overflow-x: hidden;
    line-height: 1.6;
  }

  main {
    min-height: 100vh;
    background-color: #000000;
  }

  /* Fast View Transitions - 100ms instead of default 300ms */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 100ms;
  }

  /* Global scroll-reveal classes */
  .reveal-line {
    will-change: transform;
    display: block;
  }
  .reveal-fade {
    will-change: opacity;
  }
</style>
