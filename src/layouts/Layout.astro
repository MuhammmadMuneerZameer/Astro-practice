---
import Navbar from '../components/Navbar';
import Footer from '../components/Footer.astro';
import ChatBot from '../components/ChatBot';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Hydra Fox Designs | Web Design & Digital Marketing Agency",
  description = "Hydra Fox Designs helps businesses grow through creative web design, digital marketing, and automation solutions."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/images/hfd-logo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Prevent white flash -->
    <style>
      html, body {
        background-color: #000000 !important;
        margin: 0;
        padding: 0;
      }
    </style>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="web design, digital marketing, branding, Hydra Fox Designs, SEO, website development, automation" />
    
    <!-- Theme color -->
    <meta name="theme-color" content="#000000" />

    <slot name="head" />
  </head>
  
  <body class="pt-12 sm:pt-16 md:pt-0">
    <Navbar client:only="react" />
    
    <main>
      <slot />
    </main>

    <Footer />
    <ChatBot client:load />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #1e1e1e;
    --color-primaryC: #3b3c41;
    --color-accent: rgb(99, 253, 189);
    --color-accent-hover: #48d97c;
    --color-text: #ffffff;
    --color-text-light: #b0b0b0;
    --font-size-base: 1rem;
    --font-family-base: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-family-base);
    background: #000000;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background-color: #000000;
    color: var(--color-text);
    overflow-x: hidden;
    line-height: 1.6;
  }

  main {
    min-height: 100vh;
    background-color: #000000;
  }
</style>