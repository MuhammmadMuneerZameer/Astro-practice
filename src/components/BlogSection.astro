---
// src/components/BlogSection.astro
import OptimizedBlogList from './OptimizedBlogList';
import { getPosts } from '../data/blogPost.js';
import type { Post } from './OptimizedBlogList';

// Fetch posts at build time
const allPostsData = await getPosts();

// Type and limit to 3 most recent posts
const recentPosts: Post[] = allPostsData
  .slice(0, 3)
  .map(post => ({
    id: post.id || '',
    slug: post.slug || '',
    title: post.title || 'Untitled',
    description: post.description || '',
    image: post.image || 'https://via.placeholder.com/400x300',
    tag: post.tag || null,
    category: post.category || null,
    date: post.date || new Date().toLocaleDateString(),
    content: post.content || '',
    status: post.status || 'published',
  }));
---

<section class="bg-black py-16 sm:py-20 md:py-24 px-6 text-white">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-start mb-10">
      <div>
        <p class="text-green-400 text-xs font-semibold tracking-wider uppercase mb-2">INSIGHTS</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white">
          From our <span class="text-green-300">lab</span>
        </h2>
      </div>
      <a 
        href="/resources/" 
        class="inline-flex items-center gap-1.5 bg-transparent border border-green-500 text-green-300 px-4 py-1.5 rounded-full text-sm hover:bg-green-500 hover:text-black transition whitespace-nowrap"
      >
        View all posts
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>

    </div>

    {/* Show 3 most recent posts with real-time updates */}
    <OptimizedBlogList 
      client:visible 
      initialPosts={recentPosts}
      maxPosts={3}
    />
  </div>
</section>