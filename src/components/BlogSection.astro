---
// src/components/BlogSection.astro
import OptimizedBlogList from './OptimizedBlogList';
import { getPosts } from '../data/blogPost.js';
import type { Post } from './OptimizedBlogList';

// Fetch posts at build time
const allPostsData = await getPosts();

// Type and limit to 3 most recent posts
const recentPosts: Post[] = allPostsData
  .slice(0, 3)
  .map(post => ({
    id: post.id || '',
    slug: post.slug || '',
    title: post.title || 'Untitled',
    description: post.description || '',
    image: post.image || 'https://via.placeholder.com/400x300',
    tag: post.tag || null,
    category: post.category || null,
    date: post.date || new Date().toLocaleDateString(),
    content: post.content || '',
    status: post.status || 'published',
  }));
---

<section class="bg-black py-20 px-6 text-white">
  <div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-green-300">
        From our <span class="text-white">lab</span>
      </h2>
      <a 
        href="/blog" 
        class="bg-transparent border border-green-500 text-green-300 px-4 py-1 rounded-full text-sm hover:bg-green-500 hover:text-black transition"
      >
        View all posts ↗
      </a>
    </div>

    {/* Show 3 most recent posts with real-time updates */}
    <OptimizedBlogList 
      client:visible 
      initialPosts={recentPosts}
      maxPosts={3}
    />
  </div>
</section>