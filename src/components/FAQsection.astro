---
const allFaqs = [
  {
    question: "How long does it take to design and build a website?",
    answer: "The timeline depends on the project's complexity. A basic website takes 2–4 weeks; more complex builds may take longer. We provide a project timeline after our discovery call."
  },
  {
    question: "How much does a new website cost?",
    answer: "Costs vary based on design and features. We offer custom packages tailored to your goals and budget. Get in touch for a free quote."
  },
  {
    question: "Will my website be mobile-friendly?",
    answer: "Yes. Every site we build is fully responsive and optimized for all devices — desktops, tablets, and smartphones."
  },
  {
    question: "Can I update the website myself after it's built?",
    answer: "Absolutely. We use user-friendly CMS platforms and provide tutorials so you can manage your content confidently."
  },
  {
    question: "What digital marketing services do you offer?",
    answer: "We provide complete digital marketing solutions including SEO, social media marketing, PPC ads, web design and development, and full branding strategy — everything your business needs to grow online."
  },
  {
    question: "How long does it take to see results from digital marketing?",
    answer: "Paid ads can deliver results almost immediately, while SEO and organic strategies typically take 3–6 months to show noticeable growth depending on competition and consistency."
  },
  {
    question: "Do you work with international clients?",
    answer: "Yes! We work remotely with clients around the world via Zoom, Trello, Notion, and email."
  },
  {
    question: "Do I need to sign a long-term contract?",
    answer: "No. You can start with a flexible monthly plan. We focus on delivering measurable results that keep you working with us, not on locking you into long contracts."
  },
  {
    question: "Do you offer payment plans?",
    answer: "Yes, flexible payment options are available. Most projects begin with a deposit followed by milestone-based payments."
  },
];
---

<section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="scroll-section mb-16">
      <div class="overflow-hidden mb-4">
        <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">FAQ</span>
      </div>
      <div class="overflow-hidden">
        <h2 class="reveal-line block text-5xl sm:text-6xl md:text-7xl font-heading font-bold text-white leading-none">Common Questions.</h2>
      </div>
    </div>

    <!-- Accordion items -->
    <div class="faq-list border-t border-white/10">
      {allFaqs.map((faq, i) => (
        <div
          class="faq-item border-b border-white/10 cursor-pointer"
          data-index={i}
        >
          <div class="faq-header flex justify-between items-center py-6 gap-4">
            <span class="text-base md:text-lg font-medium text-white pr-4">{faq.question}</span>
            <span class="faq-icon text-[#00f19f] text-2xl leading-none flex-shrink-0 transition-transform duration-300">+</span>
          </div>
          <div class="faq-answer overflow-hidden" style="max-height: 0;">
            <p class="pb-6 text-gray-400 leading-relaxed text-sm md:text-base">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initFAQ() {
    document.querySelectorAll('.faq-item').forEach(item => {
      const header = item.querySelector('.faq-header');
      const answer = item.querySelector<HTMLElement>('.faq-answer');
      const icon = item.querySelector<HTMLElement>('.faq-icon');
      if (!header || !answer || !icon) return;

      header.addEventListener('click', () => {
        const isOpen = answer.style.maxHeight !== '0px' && answer.style.maxHeight !== '';
        // Close all
        document.querySelectorAll('.faq-answer').forEach((a: Element) => {
          (a as HTMLElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-icon').forEach((ic: Element) => {
          (ic as HTMLElement).textContent = '+';
          (ic as HTMLElement).style.transform = 'rotate(0deg)';
        });
        // Open clicked if it was closed
        if (!isOpen) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          icon.textContent = '×';
          icon.style.transform = 'rotate(0deg)';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initFAQ);
  document.addEventListener('astro:page-load', initFAQ);
</script>

<style>
  .faq-answer {
    transition: max-height 0.45s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
</style>
