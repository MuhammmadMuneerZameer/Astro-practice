---
const allFaqs = [
  {
    question: "How long does it take to design and build a website?",
    answer: "The timeline depends on the project's complexity. A basic website takes 2–4 weeks; more complex builds may take longer. We provide a project timeline after our discovery call."
  },
  {
    question: "What do your services cost?",
    answer: "Store Design & Build starts from $4,500 (fixed price — no ongoing fee). Growth retainers start from $1,200–$2,500/mo: Ecommerce Growth from $2,500/mo, Growth Tools & Automation from $1,200/mo, and Brand & Content from $1,500/mo. All retainers are month-to-month with no lock-in. These floors mean you know whether we're in range before you reach out."
  },
  {
    question: "Will my website be mobile-friendly?",
    answer: "Yes. Every site we build is fully responsive and optimized for all devices — desktops, tablets, and smartphones."
  },
  {
    question: "Can I update the website myself after it's built?",
    answer: "Absolutely. We use user-friendly CMS platforms and provide tutorials so you can manage your content confidently."
  },
  {
    question: "What if I'm not sure which service I need?",
    answer: "Book a free 30-minute strategy call — no prep required. Tell us what's not working and we'll tell you what we'd do about it. Alternatively, request a free ecommerce growth audit and we'll review your store, ad account, and email flows and send you the three biggest gaps within 48 hours."
  },
  {
    question: "How quickly do paid media campaigns show results?",
    answer: "With Conversions API properly configured, meaningful MER data is typically available within 2–3 weeks of launch. We set a 90-day window as the minimum to draw conclusions about retention and LTV — but you'll see attribution data and early MER signals within the first month."
  },
  {
    question: "Do you work with international clients?",
    answer: "Yes! We work remotely with clients around the world via Zoom, Trello, Notion, and email."
  },
  {
    question: "Do I need to sign a long-term contract?",
    answer: "No. You can start with a flexible monthly plan. We focus on delivering measurable results that keep you working with us, not on locking you into long contracts."
  },
  {
    question: "What does your email and SMS retention work actually include?",
    answer: "We build six core flows in Klaviyo: welcome series, abandoned checkout recovery (3-touch), post-purchase upsell and review request, win-back for lapsed subscribers, browse and product abandonment, and segmentation architecture (VIP, at-risk, first-purchase, high-AOV). We report on revenue per recipient, retention revenue as a percentage of total, and LTV:CAC ratio improvement over 90-day cohorts — not open rates."
  },
  {
    question: "Do you offer payment plans?",
    answer: "Yes, flexible payment options are available. Most projects begin with a deposit followed by milestone-based payments."
  },
];
---

<section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="scroll-section mb-16">
      <div class="overflow-hidden mb-4">
        <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">FAQ</span>
      </div>
      <div class="overflow-hidden">
        <h2 class="reveal-line block text-5xl sm:text-6xl md:text-7xl font-heading font-bold text-white leading-none">Common Questions.</h2>
      </div>
    </div>

    <!-- Accordion items -->
    <div class="faq-list border-t border-white/10">
      {allFaqs.map((faq, i) => (
        <div class="faq-item border-b border-white/10" data-index={i}>
          <button
            class="faq-header w-full flex justify-between items-center py-6 gap-4 text-left bg-transparent border-0 cursor-pointer"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
          >
            <span class="text-base md:text-lg font-medium text-white pr-4">{faq.question}</span>
            <span class="faq-icon text-[#00f19f] text-2xl leading-none flex-shrink-0 transition-transform duration-300">+</span>
          </button>
          <div class="faq-answer overflow-hidden" id={`faq-answer-${i}`} role="region" style="max-height: 0;">
            <p class="pb-6 text-gray-400 leading-relaxed text-sm md:text-base">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initFAQ() {
    document.querySelectorAll('.faq-item').forEach(item => {
      const header = item.querySelector('.faq-header');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');
      if (!header || !answer || !icon) return;

      header.addEventListener('click', () => {
        const isOpen = answer.style.maxHeight !== '0px' && answer.style.maxHeight !== '';
        // Close all
        document.querySelectorAll('.faq-header').forEach((h: Element) => {
          (h as HTMLElement).setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.faq-answer').forEach((a: Element) => {
          (a as HTMLElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.faq-icon').forEach((ic: Element) => {
          (ic as HTMLElement).textContent = '+';
          (ic as HTMLElement).style.transform = 'rotate(0deg)';
        });
        // Open clicked if it was closed
        if (!isOpen) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          icon.textContent = '×';
          icon.style.transform = 'rotate(0deg)';
          header.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFAQ);
</script>

<style>
  .faq-answer {
    transition: max-height 0.45s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
</style>
