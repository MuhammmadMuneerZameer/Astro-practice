---
const faqs = [
  {
    category: "Web Design",
    items: [
      {
        question: "How long does it take to design and build a website?",
        answer: "The timeline depends on the project’s complexity. A basic website takes 2–4 weeks; more complex builds may take longer. We provide a project timeline after our discovery call."
      },
      {
        question: "How much does a new website cost?",
        answer: "Costs vary based on design and features. We offer custom packages tailored to your goals and budget. Get in touch for a free quote."
      },
      {
        question: "Will my website be mobile-friendly?",
        answer: "Yes. Every site we build is fully responsive and optimized for all devices — desktops, tablets, and smartphones."
      },
      {
        question: "Can I update the website myself after it's built?",
        answer: "Absolutely. We use user-friendly CMS platforms and provide tutorials so you can manage your content confidently."
      },
    ],
  },
 {
  category: "Digital Marketing",
  items: [
    {
      question: "What digital marketing services do you offer?",
      answer: "We provide complete digital marketing solutions including SEO, social media marketing, PPC ads, web design and development, and full branding strategy — everything your business needs to grow online."
    },
    {
      question: "How long does it take to see results from digital marketing?",
      answer: "Paid ads can deliver results almost immediately, while SEO and organic strategies typically take 3–6 months to show noticeable growth depending on competition and consistency."
    },
    {
      question: "Do you create social media content?",
      answer: "Yes. We design and manage social media content including graphics, captions, reels, and ad creatives that match your brand voice and attract your ideal audience."
    },
    {
      question: "Can you redesign or build my business website?",
      answer: "Absolutely. We create fast, mobile-optimized, and conversion-focused websites designed to generate leads and represent your brand professionally."
    },
    {
      question: "Do you offer local SEO for small businesses?",
      answer: "Yes. We optimize your Google Business Profile, local keywords, and citations to help your business rank higher in local search results and attract nearby customers."
    },
    {
      question: "How do you measure marketing success?",
      answer: "We track metrics like website traffic, lead conversions, engagement rate, and ROI. You’ll receive regular performance reports to see exactly what’s working and where to improve."
    },
    {
      question: "Do I need to sign a long-term contract?",
      answer: "No. You can start with a flexible monthly plan. We focus on delivering measurable results that keep you working with us, not on locking you into long contracts."
    }
  ],
}
,
  {
    category: "General",
    items: [
      {
        question: "Do you offer payment plans?",
        answer: "Yes, flexible payment options are available. Most projects begin with a deposit followed by milestone-based payments."
      },
      {
        question: "Do you work with international clients?",
        answer: "Yes! We work remotely with clients around the world via Zoom, Trello, Notion, and email."
      },
    ],
  }
];
---

<section class=" bg-black  px-4 py-16">
  
  <div class="max-w-5xl mx-auto">
   <h2 class="text-3xl font-bold text-center text-green-300 mb-10">Frequently Asked Questions</h2>
  
  {faqs.map((section) => (
    <div class="mb-12">
      <h3 class="text-xl font-semibold mb-4 text-gray-300">{section.category}</h3>
      <div class="space-y-4">
        {section.items.map((faq) => (
          <details class="border border-gray-800 rounded-md p-4">
            <summary class="cursor-pointer font-medium text-gray-300">
              {faq.question}
            </summary>
            <p class="mt-2 text-gray-600">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  ))} 
  </div>
</section>
