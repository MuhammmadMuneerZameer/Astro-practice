---
import projects from '../data/ProjectShowcase.js';
---

<section class="bg-black border-t border-white/10 px-4 md:px-8 py-24 text-white">
  <div class="max-w-7xl mx-auto">

    <!-- Editorial header -->
    <div class="scroll-section flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-6">
      <div>
        <div class="overflow-hidden mb-4">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            Portfolio
          </span>
        </div>
        <div class="overflow-hidden">
          <h2 class="reveal-line block text-5xl sm:text-6xl md:text-7xl font-heading font-bold text-white leading-none">
            Our Recent Work.
          </h2>
        </div>
      </div>
      <a
        href="/work/"
        class="reveal-fade group inline-flex items-center gap-3 text-white text-sm font-medium hover:text-[#00f19f] transition-colors duration-300 flex-shrink-0"
      >
        View all projects
        <span class="w-9 h-9 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300">
          <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
      </a>
    </div>

    <!-- Project list rows -->
    <div class="border-t border-white/10">
      {projects.map((project, i) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-6 md:gap-10 py-6 border-b border-white/10 hover:border-white/30 transition-colors duration-300"
        >
          <!-- Index -->
          <span class="text-gray-600 text-xs font-mono w-8 flex-shrink-0 select-none group-hover:opacity-30 transition-opacity duration-200">
            {String(i + 1).padStart(2, '0')}
          </span>

          <!-- Thumbnail -->
          {project.image && (
            <div class="w-16 h-12 rounded-lg overflow-hidden flex-shrink-0 bg-gray-900 hidden sm:block">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="64"
                height="48"
              />
            </div>
          )}

          <!-- Title + description -->
          <div class="flex-1 min-w-0">
            <h3 class="text-xl md:text-2xl lg:text-3xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors duration-300 truncate">
              {project.title}
            </h3>
            <p class="text-gray-500 text-sm mt-0.5 hidden md:block line-clamp-1">{project.description}</p>
          </div>

          <!-- Tech tags -->
          {project.technologies && (
            <div class="hidden lg:flex flex-wrap gap-2 max-w-xs flex-shrink-0">
              {project.technologies.slice(0, 2).map((tech: string) => (
                <span class="px-3 py-1 border border-white/10 text-gray-500 text-xs rounded-full">
                  {tech}
                </span>
              ))}
            </div>
          )}

          <!-- Arrow -->
          <span class="w-9 h-9 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300 flex-shrink-0">
            <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>

  </div>
</section>
