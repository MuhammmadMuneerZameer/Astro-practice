---
import { getCollection } from 'astro:content';
const entries = await getCollection('case-studies');
const cs = entries.find(e => e.data.featured) ?? entries[0];
---

{cs && (
  <section class="flagship-section bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">

      <div class="mb-10 flex items-end justify-between gap-6">
        <div>
          <div class="overflow-hidden mb-4">
            <p class="flagship-reveal text-[#00f19f] text-xs font-bold tracking-[0.2em] uppercase">Featured result</p>
          </div>
          <h2 class="font-heading font-bold text-white leading-none">
            <div class="overflow-hidden">
              <span class="flagship-reveal block text-4xl sm:text-5xl md:text-6xl">Our flagship build.</span>
            </div>
          </h2>
        </div>
        <a href="/work/" class="flagship-fade text-gray-500 hover:text-white text-sm transition-colors flex-shrink-0 mb-1">
          All work →
        </a>
      </div>

      <a href={`/case-studies/${cs.slug}/`} class="flagship-card group block">
        <div class="aspect-video md:aspect-[16/7] rounded-2xl overflow-hidden mb-6 bg-gray-900">
          <img
            src={cs.data.image ?? '/images/desktop-opt.webp'}
            alt={cs.data.title}
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700"
            width="1200"
            height="525"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div class="flex-1">
            <p class="text-[#00f19f] text-xs font-mono tracking-widest uppercase mb-3">{cs.data.client} · {cs.data.timeframe}</p>
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors duration-300 mb-4 max-w-2xl">
              {cs.data.title}
            </h3>
            {cs.data.problem && (
              <p class="text-gray-400 text-sm leading-relaxed max-w-xl">{cs.data.problem}</p>
            )}
          </div>
          <span class="w-12 h-12 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300 flex-shrink-0">
            <svg class="w-5 h-5 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </a>

    </div>
  </section>
)}

<script>
  const EXPO = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initFlagship() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const lines = entry.target.querySelectorAll('.flagship-reveal');
        const fades = entry.target.querySelectorAll('.flagship-fade');
        const card = entry.target.querySelector('.flagship-card');

        lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
        lines.forEach((el, i) => {
          el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 120, easing: EXPO, fill: 'forwards' }
          ).onfinish = () => { el.style.willChange = 'auto'; };
        });
        fades.forEach((el, i) => {
          el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 600, delay: 300 + i * 80, easing: CUBIC, fill: 'forwards' }
          );
        });
        if (card) {
          card.animate(
            [{ opacity: '0', transform: 'translateY(20px)' }, { opacity: '1', transform: 'translateY(0)' }],
            { duration: 800, delay: 400, easing: EXPO, fill: 'forwards' }
          );
        }
        io.unobserve(entry.target);
      });
    }, { threshold: 0.1 });

    const section = document.querySelector('.flagship-section');
    if (section) io.observe(section);
  }

  document.addEventListener('astro:page-load', initFlagship);
</script>

<style>
  .flagship-reveal { will-change: transform; display: block; }
  .flagship-fade { opacity: 0; }
  .flagship-card { opacity: 0; }
</style>
