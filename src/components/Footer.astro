---
---

<footer class="relative bg-black text-white overflow-hidden">

  <!-- -- Background gradient (replaces 721 KB Spline bundle) ---------------- -->
  <div
    class="absolute inset-0 z-0 pointer-events-none"
    style="background: radial-gradient(ellipse 80% 60% at 50% 120%, #00f19f22 0%, #0a1a2e44 60%, transparent 100%); filter: blur(40px);"
    aria-hidden="true"
  ></div>

  <!-- -- Big CTA section ----------------------------------------------------- -->
  <div class="footer-cta relative z-10 border-t border-white/10 px-4 md:px-8 pt-24 pb-20">
    <div class="max-w-7xl mx-auto">

      <!-- "Start a project" label -->
      <div class="overflow-hidden mb-6">
        <span class="footer-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          Start a project
        </span>
      </div>

      <!-- Big heading — two masked lines -->
      <a href="/contact/" class="group block">
        <h2 class="font-heading font-bold leading-none tracking-tight">
          <div class="overflow-hidden">
            <span class="footer-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white group-hover:text-[#00f19f] transition-colors duration-500">
              Let's work
            </span>
          </div>
          <div class="overflow-hidden flex items-end gap-6 md:gap-10">
            <span class="footer-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white group-hover:text-[#00f19f] transition-colors duration-500">
              together
            </span>
            <!-- Animated arrow button -->
            <div class="footer-reveal-fade mb-3 md:mb-5 lg:mb-8 w-14 h-14 md:w-20 md:h-20 rounded-full border-2 border-white/30 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-500 flex-shrink-0">
              <svg class="w-5 h-5 md:w-7 md:h-7 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </h2>
      </a>

      <!-- Secondary CTAs -->
      <div class="mt-10 flex flex-col gap-3">
        <a href="mailto:muneerzameer@hydrafoxdesigns.com"
           class="footer-reveal-fade block text-gray-500 hover:text-[#00f19f] transition-colors duration-300 text-sm md:text-base font-mono">
          muneerzameer@hydrafoxdesigns.com
        </a>
        <!-- REPLACE with your Cal.com or Calendly URL -->
        <a href="https://cal.com/hydra-fox-sqrqbz/30min"
           target="_blank" rel="noopener noreferrer"
           class="footer-reveal-fade inline-flex items-center gap-2 text-[#00f19f] hover:text-white transition-colors duration-300 text-sm font-mono font-bold">
          Book a 30-min call
          <svg class="w-3.5 h-3.5 -rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <!-- UPDATE: replace number with your WhatsApp in international format, e.g. 923354345625 -->
        <a href="https://wa.me/923354345625"
           target="_blank" rel="noopener noreferrer"
           class="footer-reveal-fade inline-flex items-center gap-2 text-gray-500 hover:text-[#00f19f] transition-colors duration-300 text-sm font-mono">
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- -- Bottom bar ----------------------------------------------------------- -->
  <div class="relative z-10 border-t border-white/10 px-4 md:px-8 py-10">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-10">

      <!-- Brand + copyright -->
      <div class="footer-reveal-fade">
        <div class="flex items-center gap-3 mb-3">
          <img src="/images/hfd-logo-withoutBg.png" alt="Hydra Fox Designs Logo"
               class="w-6 h-6 object-contain" width="24" height="24" loading="lazy" />
          <span class="font-bold text-sm tracking-wide">Hydra Fox Designs</span>
        </div>
        <p class="text-gray-600 text-xs">
          &copy; {new Date().getFullYear()} Hydra Fox Designs. All rights reserved.
        </p>
        <p class="text-gray-500 text-xs mt-1.5 font-mono">
          Karachi, Pakistan
        </p>
        <p class="text-gray-600 text-xs mt-0.5">
          Response within 24 hrs · Same-day for Gulf & UK
        </p>
        <p class="text-gray-600 text-xs mt-1">
          <a href="/privacy-pages/" class="hover:text-gray-400 transition-colors">Privacy Policy</a>
        </p>
      </div>

      <!-- Nav links -->
      <nav class="footer-reveal-fade">
        <ul class="flex flex-wrap gap-x-8 gap-y-3">
          {[
            { href: '/',              label: 'Home' },
            { href: '/services/',     label: 'Services' },
            { href: '/work/',         label: 'Work' },
            { href: '/industries/',   label: 'Industries' },
            { href: '/resources/',    label: 'Resources' },
            { href: '/about/',        label: 'About' },
            { href: '/process/',      label: 'Process' },
            { href: '/contact/',      label: 'Contact' },
          ].map(({ href, label }) => (
            <li>
              <a href={href}
                 class="text-gray-500 hover:text-white text-sm transition-colors duration-200">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Social links -->
      <div class="footer-reveal-fade flex items-center gap-5">
        <a href="https://www.facebook.com/hydrafoxdesign"
           aria-label="Facebook"
           class="text-gray-600 hover:text-white transition-colors duration-200">
          <img src="/images/facebook.png" alt="Facebook"
               class="w-5 h-5 opacity-50 hover:opacity-100 transition-opacity"
               loading="lazy" width="20" height="20" />
        </a>
        <a href="https://www.instagram.com/official_hydra_fox/"
           aria-label="Instagram"
           class="text-gray-600 hover:text-white transition-colors duration-200">
          <img src="/images/instagram.png" alt="Instagram"
               class="w-5 h-5 opacity-50 hover:opacity-100 transition-opacity"
               loading="lazy" width="20" height="20" />
        </a>
        <a href="https://www.linkedin.com/company/hydrafox-designs/"
           aria-label="LinkedIn"
           class="text-gray-600 hover:text-white transition-colors duration-200">
          <img src="/images/linkedin.png" alt="LinkedIn"
               class="w-5 h-5 opacity-50 hover:opacity-100 transition-opacity"
               loading="lazy" width="20" height="20" />
        </a>
      </div>
    </div>
  </div>

</footer>

<!-- -- Scroll-triggered animations --------------------------------------------- -->
<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initFooterAnimations() {
    const revealLines = document.querySelectorAll('.footer-reveal-line');
    const revealFades = document.querySelectorAll('.footer-reveal-fade');

    // Set initial hidden state
    revealLines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    revealFades.forEach(el => { el.style.opacity = '0'; });

    // Observe the CTA section to trigger on scroll
    const cta = document.querySelector('.footer-cta');
    if (!cta) return;

    let triggered = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && !triggered) {
          triggered = true;

          revealLines.forEach((el, i) => {
            const anim = el.animate(
              [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
              { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
            );
            anim.onfinish = () => { el.style.willChange = 'auto'; };
          });

          revealFades.forEach((el, i) => {
            const anim = el.animate(
              [{ opacity: '0' }, { opacity: '1' }],
              { duration: 700, delay: 300 + i * 120, easing: CUBIC_OUT, fill: 'forwards' }
            );
            anim.onfinish = () => { el.style.willChange = 'auto'; };
          });

          observer.disconnect();
        }
      },
      { threshold: 0.15 }
    );

    observer.observe(cta);
  }

  document.addEventListener('astro:page-load', initFooterAnimations);
</script>

<style>
  .footer-reveal-line {
    will-change: transform;
    display: block;
  }
  .footer-reveal-fade {
    will-change: opacity;
  }
</style>
