---
import Spline from "@splinetool/react-spline";
import Splineanimation from "./Splineanimation";
---

<footer
  class="relative bg-black text-white py-12 sm:py-16 px-4 sm:px-6 w-full overflow-hidden"
>
  <!-- ✅ Background Spline Animation -->
  <div class="absolute inset-0 z-0 blur opacity-50 pointer-events-none">
    <Splineanimation client:only="react" />
  </div>

  <!-- ✅ Foreground Footer Content -->
  <div
    class="relative z-10 mx-auto max-w-5xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
  >
    <div class="sm:col-span-2 lg:col-span-1">
      <h2 class="font-bold text-lg mb-2">Hydra Fox Designs</h2>
      <p class="text-gray-300 mb-2 text-sm sm:text-base">
        Providing quality services and products to help you succeed.
      </p>
      <p class="text-gray-400 text-xs sm:text-sm">
        &copy; {new Date().getFullYear()} Hydra Fox. All rights reserved.
      </p>
    </div>
    <div>
      <h2 class="font-bold text-base sm:text-lg mb-2">Quick Links</h2>
      <ul class="space-y-1">
        <li>
          <a href="/" class="hover:text-green-300 text-sm sm:text-base">Home</a>
        </li>
        <li>
          <a href="/services/" class="hover:text-green-300 text-sm sm:text-base"
            >Services</a>
        </li>
        <li>
          <a href="/work/" class="hover:text-green-300 text-sm sm:text-base"
            >Work</a>
        </li>
        <li>
          <a
            href="/industries/"
            class="hover:text-green-300 text-sm sm:text-base">Industries</a>
        </li>
        <li>
          <a
            href="/resources/"
            class="hover:text-green-300 text-sm sm:text-base">Resources</a>
        </li>
        <li>
          <a href="/about/" class="hover:text-green-300 text-sm sm:text-base"
            >About</a>
        </li>
        <li>
          <a href="/contact/" class="hover:text-green-300 text-sm sm:text-base"
            >Contact</a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="font-bold text-base sm:text-lg mb-2">Contact Us</h2>
      <p class="text-gray-300 text-sm sm:text-base break-all">
        Email: muneerzameer@hydrafoxdesigns.com
      </p>
      <p class="text-gray-300 text-sm sm:text-base">Phone: +92 3354345625</p>
      <div class="flex gap-3 mt-2">
        <a href="https://www.facebook.com/hydrafoxdesign" aria-label="Facebook"
          ><img
            src="/images/facebook (1).png"
            alt="Facebook"
            class="w-4 sm:w-5 opacity-50 hover:opacity-100"
            loading="lazy"
            width="20"
            height="20"
          /></a
        >
        <a
          href="https://www.instagram.com/official_hydra_fox/"
          aria-label="Instagram"
          ><img
            src="/images/instagram (1).png"
            alt="Instagram"
            class="w-4 sm:w-5 opacity-50 hover:opacity-100"
            loading="lazy"
            width="20"
            height="20"
          /></a
        >
        <a
          href="https://www.linkedin.com/company/hydrafox-designs/"
          aria-label="LinkedIn"
          ><img
            src="/images/linkedin.png"
            alt="LinkedIn"
            class="w-4 sm:w-5 opacity-50 hover:opacity-100"
            loading="lazy"
            width="20"
            height="20"
          /></a
        >
      </div>
    </div>
  </div>
</footer>
