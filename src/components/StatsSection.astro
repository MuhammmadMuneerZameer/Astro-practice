---
const stats = [
  { value: "50+", label: "Projects Delivered" },
  { value: "30+", label: "Happy Clients" },
  { value: "3+",  label: "Years Experience" },
  { value: "100%", label: "Client Satisfaction" },
];
---

<section class="border-t border-white/10 bg-black py-16 px-4 md:px-8">
  <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 divide-x divide-white/10">
    {stats.map((stat) => (
      <div class="scroll-section px-6 md:px-10 py-4 text-center">
        <span class="reveal-line block text-5xl md:text-6xl font-heading font-bold text-[#00f19f] tabular-nums leading-none">
          {stat.value}
        </span>
        <span class="reveal-fade block text-gray-500 text-xs uppercase tracking-wider mt-3">
          {stat.label}
        </span>
      </div>
    ))}
  </div>
</section>
