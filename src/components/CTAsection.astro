---
---

<section class="scroll-section border-t border-white/10 bg-black px-4 md:px-8 pt-24 pb-20">
  <div class="max-w-7xl mx-auto">

    <!-- Label -->
    <div class="overflow-hidden mb-6">
      <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
        Start a project
      </span>
    </div>

    <!-- Big CTA heading -->
    <a href="/contact/" class="group block">
      <h2 class="font-heading font-bold leading-none tracking-tight">
        <div class="overflow-hidden">
          <span class="reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white group-hover:text-[#00f19f] transition-colors duration-500">
            Ready to grow
          </span>
        </div>
        <div class="overflow-hidden flex items-end gap-6 md:gap-10">
          <span class="reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white group-hover:text-[#00f19f] transition-colors duration-500">
            your brand?
          </span>
          <!-- Animated arrow -->
          <div class="reveal-fade mb-3 md:mb-5 lg:mb-8 w-14 h-14 md:w-20 md:h-20 rounded-full border-2 border-white/30 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-500 flex-shrink-0">
            <svg class="w-5 h-5 md:w-7 md:h-7 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </h2>
    </a>

  </div>
</section>
