---
const { image, title, description, tag } = Astro.props;
---

<div class="bg-black border border-white/10 hover:border-white/25 rounded-2xl overflow-hidden transition-colors duration-300 h-full flex flex-col group">
  <div class="relative overflow-hidden">
    <img src={image} alt={title} class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-[1.03]" width="800" height="450" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
  </div>
  <div class="p-5 flex flex-col flex-grow gap-3">
    {tag && <span class="text-[#00f19f] text-[10px] font-bold tracking-[0.18em] uppercase">{tag}</span>}
    <h3 class="text-white font-heading font-bold text-lg leading-snug group-hover:text-[#00f19f] transition-colors duration-300 line-clamp-3">{title}</h3>
    <p class="text-gray-500 text-sm leading-relaxed line-clamp-2 mt-auto">{description}</p>
  </div>
</div>
