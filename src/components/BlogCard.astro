---
const { image, title, description, tag } = Astro.props;
---

<div class="bg-black rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300 h-full flex flex-col">
  <img src={image} alt={title} class="w-full h-40 sm:h-48 object-cover" loading="lazy" />
  <div class="p-3 sm:p-4 flex flex-col flex-grow">
    {tag && <span class="text-xs bg-purple-500 text-white px-2 py-1 rounded w-fit mb-2">{tag}</span>}
    <h3 class="text-white text-base sm:text-lg font-semibold leading-tight mb-2">{title}</h3>
    <p class="text-gray-300 text-xs sm:text-sm mt-auto line-clamp-3">{description}</p>
  </div>
</div>
