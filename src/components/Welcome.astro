---
import Splineanimation from "./Splineanimation";
---

<div class="hero-container relative min-h-screen flex flex-col justify-end pb-20 md:pb-28 px-4 md:px-8 bg-black overflow-hidden">

  <!-- Background Spline -->
  <div id="hero-bg-layer" class="absolute inset-0 z-0 opacity-40 pointer-events-none">
    <Splineanimation client:load />
  </div>


<!-- Content -->
  <div id="hero-content-layer" class="relative z-10 max-w-7xl mx-auto w-full">

    <!-- "Digital Agency" label -->
    <div class="overflow-hidden mb-6">
      <span class="welcome-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
        Digital Agency
      </span>
    </div>

    <!-- Hero heading — two masked lines -->
    <h1 class="font-heading font-bold leading-none tracking-tight mb-10">
      <div class="overflow-hidden">
        <span class="welcome-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
          We build brands
        </span>
      </div>
      <div class="overflow-hidden">
        <span id="hero-scramble" class="welcome-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-[#00f19f]">
          that convert.
        </span>
      </div>
    </h1>

    <!-- Sub-copy + dual CTAs -->
    <div class="flex flex-col sm:flex-row sm:items-end gap-8">
      <div class="overflow-hidden flex-1">
        <p class="welcome-reveal-fade text-gray-400 text-base md:text-lg max-w-xl font-light leading-relaxed">
          Most agencies hand you a website. We hand you a growth system —
          design, development, and marketing engineered to turn visitors
          into paying clients.
        </p>
      </div>
      <div class="welcome-reveal-fade flex flex-col sm:flex-row items-start sm:items-center gap-4 flex-shrink-0">
        <a
          href="/contact/"
          class="group inline-flex items-center gap-3 text-white text-sm md:text-base font-medium hover:text-[#00f19f] transition-colors duration-300"
        >
          Start a project
          <span class="w-10 h-10 rounded-full border border-white/30 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-500">
            <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
        <a
          href="#work"
          class="text-gray-500 text-sm md:text-base font-medium hover:text-white transition-colors duration-300 flex items-center gap-2"
        >
          See our work
          <svg class="w-4 h-4 rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  // Character scramble on the accent line
  function scrambleText(el: HTMLElement, finalText: string, delay: number) {
    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$';
    const DURATION = 900;
    const STEP_MS = 32;

    setTimeout(() => {
      let iterations = 0;
      const totalSteps = DURATION / STEP_MS;

      const interval = setInterval(() => {
        el.textContent = finalText
          .split('')
          .map((char, i) => {
            if (char === ' ' || char === '.') return char;
            // Resolve left-to-right progressively
            if (i < (iterations / totalSteps) * finalText.length) return char;
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          })
          .join('');
        iterations++;
        if (iterations >= totalSteps) {
          el.textContent = finalText;
          clearInterval(interval);
        }
      }, STEP_MS);
    }, delay);
  }

  function initWelcomeAnimations() {
    const lines = document.querySelectorAll<HTMLElement>('.welcome-reveal-line');
    const fades = document.querySelectorAll<HTMLElement>('.welcome-reveal-fade');
    const scrambleEl = document.getElementById('hero-scramble') as HTMLElement | null;
    const finalText = 'that convert.';

    lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    fades.forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lines.forEach((el, i) => {
          el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
        });
        fades.forEach((el, i) => {
          el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 600 + i * 120, easing: CUBIC_OUT, fill: 'forwards' }
          );
        });
        // Scramble starts after the line has slid up (line index 1 = 130ms delay + 900ms duration)
        if (scrambleEl) scrambleText(scrambleEl, finalText, 1100);
      });
    });
  }

  function initHeroParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const hero    = document.querySelector<HTMLElement>('.hero-container');
    const bgLayer = document.getElementById('hero-bg-layer') as HTMLElement | null;
    const content = document.getElementById('hero-content-layer') as HTMLElement | null;
    if (!hero || !bgLayer || !content) return;

    const BG_SPEED       = 0.25;
    const CONTENT_SPEED  = 0.08;
    const MAX_BG_DRIFT   = 80;
    const MAX_TEXT_DRIFT = 30;

    let scrollY    = 0;
    let ticking    = false;
    let rafId      = 0;
    let heroBottom = 0;

    function measureHero() {
      heroBottom = hero.getBoundingClientRect().bottom + window.scrollY;
    }

    function applyParallax() {
      ticking = false;
      if (scrollY > heroBottom) { cancelAnimationFrame(rafId); return; }
      bgLayer.style.transform = `translateY(${Math.min(scrollY * BG_SPEED, MAX_BG_DRIFT)}px) translateZ(0)`;
      content.style.transform = `translateY(-${Math.min(scrollY * CONTENT_SPEED, MAX_TEXT_DRIFT)}px) translateZ(0)`;
    }

    function onScroll() {
      scrollY = window.scrollY;
      if (scrollY <= heroBottom && !ticking) {
        ticking = true;
        rafId = requestAnimationFrame(applyParallax);
      }
    }

    measureHero();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measureHero, { passive: true });

    document.addEventListener('astro:before-preparation', () => {
      cancelAnimationFrame(rafId);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', measureHero);
      bgLayer.style.transform = '';
      content.style.transform = '';
    }, { once: true });
  }

  document.addEventListener('DOMContentLoaded', () => { initWelcomeAnimations(); initHeroParallax(); });
  document.addEventListener('astro:page-load',  () => { initWelcomeAnimations(); initHeroParallax(); });
</script>

<style>
  .hero-container {
    min-height: 100vh;
    min-height: 100dvh;
  }
  .welcome-reveal-line {
    will-change: transform;
  }
  .welcome-reveal-fade {
    will-change: opacity;
  }
  #hero-bg-layer,
  #hero-content-layer {
    will-change: transform;
    transform: translateZ(0);
  }
</style>
