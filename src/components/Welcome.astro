---
import Splineanimation from './Splineanimation';
import SplitTextComponent from './SplitTextComponent';
---

<div
  class="hero-container relative min-h-screen flex flex-col items-center justify-center text-center px-4 sm:px-6 lg:px-8 overflow-hidden w-full"
>
  <!-- Background Spline Animation -->
  <div class="absolute inset-0 w-full h-full z-0">
    <Splineanimation client:only="react" />
  </div>

  <!-- Content Wrapper -->
  <div class="relative z-10 flex flex-col items-center justify-center gap-6 sm:gap-8 md:gap-10 w-full max-w-7xl mx-auto">
    
    <!-- Text Content -->
    <div class="w-full px-2 sm:px-4">
      <SplitTextComponent client:only="react" />
    </div>

    <!-- CTA Button with Better Touch Targets -->
    
    <a id="hero-button"
      href="/ContactUs"
      class="hero-button group relative inline-flex items-center justify-center px-6 sm:px-8 md:px-10 py-3 sm:py-3.5 md:py-4 text-white font-medium rounded-full bg-black/80 backdrop-blur-sm shadow-md transition-all duration-300 overflow-hidden text-sm sm:text-base md:text-lg mt-2 sm:mt-4 touch-manipulation"
    >
      <span class="relative z-10 flex items-center gap-2 sm:gap-3">
        Start a project
        <svg
          class="w-4 h-4 sm:w-5 sm:h-5 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </span>
      
      <span class="absolute inset-0 rounded-full bg-green-400 opacity-0 group-hover:opacity-30 transition-all duration-300"></span>
      <span class="absolute inset-0 rounded-full border border-green-400 opacity-0 group-hover:opacity-100 transition-all duration-500"></span>
    </a>
  </div>
</div>

<style>
  /* Hero Container */
  .hero-container {
    min-height: 100vh;
    min-height: 100dvh; /* Dynamic viewport height for mobile */
  }

  /* Remove any negative margin on mobile */
  @media (max-width: 768px) {
    .hero-container {
      margin-top: 0 !important;
      padding-top: 60px; /* Account for fixed navbar if you have one */
    }
  }

  /* Button Styles */
  .hero-button {
    box-shadow: 0 4px 20px rgba(99, 253, 189, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    min-height: 44px; /* iOS recommended touch target */
    -webkit-tap-highlight-color: transparent; /* Remove tap highlight on mobile */
  }
  
  .hero-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(99, 253, 189, 0.4);
  }

  /* Better touch interaction on mobile */
  .hero-button:active {
    transform: translateY(0);
  }

  /* Prevent horizontal scroll */
  :global(html, body) {
    overflow-x: hidden;
    max-width: 100vw;
  }

  /* Safe area for notched devices (iPhone X+) */
  @supports (padding: max(0px)) {
    .hero-container {
      padding-left: max(1rem, env(safe-area-inset-left));
      padding-right: max(1rem, env(safe-area-inset-right));
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
    }
  }

  /* Improve rendering performance */
  .hero-button {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
</style>