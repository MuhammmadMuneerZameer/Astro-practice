---
// src/pages/blog.astro
import Layout from '../layouts/Layout.astro';
import OptimizedBlogList from '../components/OptimizedBlogList.js';
import Splineanimation from '../components/Splineanimation';
import { getPosts } from '../data/blogPost.js';
import type { Post } from '../components/OptimizedBlogList.js';

// Fetch posts at build time for SEO and initial load
const postsData = await getPosts();

// Type the posts data explicitly
const initialPosts: Post[] = postsData.map(post => ({
  id: post.id || '',
  slug: post.slug || '',
  title: post.title || 'Untitled',
  description: post.description || '',
  image: post.image || 'https://via.placeholder.com/400x300',
  tag: post.tag || null,
  category: post.category || null,
  date: post.date || new Date().toLocaleDateString(),
  content: post.content || '',
  status: post.status || 'published',
}));
---

<Layout>
  <!-- Hero/Search Section -->
  <section class="relative w-full h-[250px] sm:h-[300px] flex flex-col items-center justify-center bg-black text-white -mt-12 sm:-mt-16 md:mt-0">
    <div class="absolute inset-0 z-0 h-[50vh] blur opacity-50">
      <Splineanimation client:only="react" />
    </div>
   
    <div class="relative z-10 px-4 mt-16 sm:mt-24 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-center mb-4 sm:mb-6 pt-16 sm:pt-24 text-green-300">
        Our Blog
      </h1>
      <p class="text-gray-400 max-w-2xl mx-auto mb-6">
        Discover insights, tutorials, and updates from our team
      </p>
    </div>
  </section>

  <!-- Posts Section -->
  <section class="bg-black text-white pt-10 sm:pt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
      {/* 
        This component:
        1. Shows initialPosts immediately (SEO-friendly)
        2. Subscribes to real-time updates after page load
        3. Falls back to cached data if Firebase fails
      */}
      <OptimizedBlogList 
        client:load 
        initialPosts={initialPosts}
        maxPosts={100}
      />
    </div>
  </section>
</Layout>