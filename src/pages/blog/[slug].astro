---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../data/blogPost.js';

// Define the type for a blog post
interface BlogPost {
  id: string;
  title: string;
  content: string;
  description: string;
  image: string;
  date: string;
  slug: string;
  tag?: string;
  category?: string;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

// Type the Astro.props
interface Props {
  post: BlogPost;
}

const { post } = Astro.props as Props;

// Type the content variable
const content: string = post.content || '';
---

<Layout
  title={`${post.title} | Hydra Fox Designs`}
  description={post.description}
>
  <article class="bg-black min-h-screen text-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a 
        href="/blog" 
        class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 mb-8 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Blog
      </a>

      <!-- Header -->
      <header class="mb-8">
        <div class="flex flex-wrap gap-3 mb-4">
          {post.tag && (
            <span class="bg-green-500/20 text-green-300 px-4 py-1.5 rounded-full text-sm font-medium">
              {post.tag}
            </span>
          )}
          {post.category && (
            <span class="bg-blue-500/20 text-blue-300 px-4 py-1.5 rounded-full text-sm font-medium">
              {post.category}
            </span>
          )}
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">
          {post.title}
        </h1>
        
        <div class="flex items-center gap-4 text-gray-400 text-sm">
          <time datetime={post.date}>
            {post.date}
          </time>
        </div>
      </header>

      <!-- Featured Image -->
      {post.image && (
        <div class="mb-12 rounded-xl overflow-hidden">
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <div class="text-gray-300 leading-relaxed whitespace-pre-wrap">
          {content}
        </div>
      </div>

      <!-- Footer Navigation -->
      <div class="mt-16 pt-8 border-t border-gray-800">
        <a 
          href="/blog" 
          class="inline-flex items-center justify-center px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-full transition-colors"
        >
          View All Posts
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Custom prose styling for better readability */
  .prose {
    color: #e5e7eb;
  }
  
  .prose p {
    margin-bottom: 1.5em;
    line-height: 1.8;
  }
  
  .prose h2 {
    color: #86efac;
    margin-top: 2em;
    margin-bottom: 1em;
    font-size: 1.875rem;
    font-weight: 700;
  }
  
  .prose h3 {
    color: #86efac;
    margin-top: 1.5em;
    margin-bottom: 0.75em;
    font-size: 1.5rem;
    font-weight: 600;
  }
  
  .prose ul, .prose ol {
    margin-top: 1em;
    margin-bottom: 1em;
    padding-left: 1.5em;
  }
  
  .prose li {
    margin-bottom: 0.5em;
  }
  
  .prose a {
    color: #86efac;
    text-decoration: underline;
  }
  
  .prose a:hover {
    color: #4ade80;
  }
  
  .prose strong {
    color: #fff;
    font-weight: 600;
  }
  
  .prose code {
    background-color: rgba(0, 241, 159, 0.1);
    color: #86efac;
    padding: 0.25em 0.5em;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  
  .prose pre {
    background-color: #1f2937;
    padding: 1.5em;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }
  
  .prose blockquote {
    border-left: 4px solid #86efac;
    padding-left: 1em;
    margin-left: 0;
    font-style: italic;
    color: #d1d5db;
  }
</style>