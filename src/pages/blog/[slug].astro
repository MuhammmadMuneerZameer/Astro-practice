---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug, getPosts } from '../../data/blogPost.js';

// This tells Astro to generate pages for ALL blog posts at build time
export async function getStaticPaths() {
  console.log('🔄 Generating static blog pages...');
  const posts = await getPosts();
  console.log(`✅ Found ${posts.length} posts to generate`);
  
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

// Get the post from props (already fetched in getStaticPaths)
const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const content: string = post.content || '';

function parseContent(text: string) {
  const lines = text.split('\n');
  const parsed = [];
  
  for (const line of lines) {
    const trimmed = line.trim();
    
    if (trimmed.match(/^https?:\/\/.+\.(jpg|jpeg|png|gif|webp|svg)$/i)) {
      parsed.push({ type: 'image', url: trimmed });
    } else if (trimmed.match(/^!\[.*?\]\(.+?\)$/)) {
      const match = trimmed.match(/!\[(.*?)\]\((.+?)\)/);
      if (match) {
        parsed.push({ type: 'image', url: match[2], alt: match[1] });
      }
    } else if (trimmed) {
      parsed.push({ type: 'text', content: trimmed });
    }
  }
  
  return parsed;
}

const parsedContent = parseContent(content);
---

<Layout
  title={`${post.title} | Hydra Fox Designs`}
  description={post.description}
>
  <article class="bg-black min-h-screen text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
      
      <!-- Back Button -->
      <a 
        href="/blog" 
        class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 mb-8 sm:mb-12 transition-colors group"
      >
        <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="text-sm sm:text-base font-medium">Back to Blog</span>
      </a>

      <!-- Header -->
      <header class="mb-8 sm:mb-12">
        <div class="flex flex-wrap gap-2 sm:gap-3 mb-4 sm:mb-6">
          {post.tag && (
            <span class="bg-green-500/20 text-green-300 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium border border-green-500/30">
              {post.tag}
            </span>
          )}
          {post.category && (
            <span class="bg-blue-500/20 text-blue-300 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full text-xs sm:text-sm font-medium border border-blue-500/30">
              {post.category}
            </span>
          )}
        </div>
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 sm:mb-6 leading-tight tracking-tight">
          {post.title}
        </h1>
        
        <div class="flex flex-wrap items-center gap-4 text-gray-400 text-sm sm:text-base border-t border-gray-800 pt-4 sm:pt-6">
          <time datetime={post.date} class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {post.date}
          </time>
          <span class="text-gray-600">•</span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            {Math.ceil(content.split(' ').length / 200)} min read
          </span>
        </div>
      </header>

      <!-- Featured Image -->
      {post.image && (
        <div class="mb-12 sm:mb-16 rounded-xl overflow-hidden bg-gray-900 shadow-2xl">
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      )}

      <!-- Description -->
      {post.description && (
        <div class="mb-8 p-6 bg-gray-900/50 border-l-4 border-green-500 rounded-r-lg">
          <p class="text-gray-300 text-lg leading-relaxed italic">{post.description}</p>
        </div>
      )}

      <!-- Content -->
      <div class="prose-custom space-y-6">
        {parsedContent.map((item) => (
          item.type === 'image' ? (
            <figure class="content-image my-8 sm:my-12">
              <img 
                src={item.url} 
                alt={item.alt || 'Blog content image'}
                class="w-full h-auto rounded-xl object-cover shadow-lg"
                loading="lazy"
              />
              {item.alt && (
                <figcaption class="text-center text-gray-400 text-sm mt-3">
                  {item.alt}
                </figcaption>
              )}
            </figure>
          ) : (
            <p class="content-paragraph">
              {item.content}
            </p>
          )
        ))}
      </div>

      <!-- Share Section -->
      <div class="mt-12 sm:mt-16 pt-8 sm:pt-12 border-t border-gray-800">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-white mb-2">Share this article</h3>
            <div class="flex gap-3">
              <a href={`https://twitter.com/intent/tweet?url=${Astro.url}&text=${post.title}`} 
                 target="_blank"
                 rel="noopener noreferrer"
                 class="p-2.5 bg-gray-800 hover:bg-green-500 text-gray-300 hover:text-black rounded-lg transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`}
                 target="_blank"
                 rel="noopener noreferrer"
                 class="p-2.5 bg-gray-800 hover:bg-green-500 text-gray-300 hover:text-black rounded-lg transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${Astro.url}&title=${post.title}`}
                 target="_blank"
                 rel="noopener noreferrer"
                 class="p-2.5 bg-gray-800 hover:bg-green-500 text-gray-300 hover:text-black rounded-lg transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
          <a 
            href="/blog" 
            class="inline-flex items-center justify-center px-6 py-3 bg-green-500 hover:bg-green-600 text-black font-semibold rounded-full transition-all duration-300 shadow-lg hover:shadow-green-500/50 w-full sm:w-auto"
          >
            View All Posts
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose-custom {
    color: #e5e7eb;
    font-size: 1.125rem;
    line-height: 1.8;
  }
  
  @media (max-width: 640px) {
    .prose-custom {
      font-size: 1rem;
      line-height: 1.7;
    }
  }
  
  .content-paragraph {
    margin-bottom: 1.75em;
    color: #d1d5db;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  
  .content-image {
    margin: 3rem 0;
  }
  
  .content-image img {
    border: 1px solid rgba(134, 239, 172, 0.1);
    transition: all 0.3s ease;
  }
  
  .content-image img:hover {
    border-color: rgba(134, 239, 172, 0.3);
    transform: scale(1.01);
  }
</style>