---
import "../styles/global.css";
import "../styles/fonts.css";
import AdminAuth from "../components/AdminAuth";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/images/hfd-logo.png" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <title>Admin Dashboard | Hydra Fox Designs</title>
    <style>
      html, body { margin: 0; padding: 0; background: #000; }
    </style>
  </head>
  <body>
    <header
      class="fixed top-0 left-0 right-0 z-50 h-14 flex items-center justify-between px-6 border-b border-white/10"
      style="background: rgba(0,0,0,0.9); backdrop-filter: blur(12px);"
    >
      <a href="/" class="flex items-center gap-2 text-white hover:text-[#00f19f] transition-colors duration-200">
        <img src="/images/hfd-logo-withoutBg.png" alt="Hydra Fox Designs" class="w-6 h-6 object-contain" width="24" height="24" />
        <span class="text-sm font-semibold tracking-wide">Hydra Fox</span>
      </a>
      <span class="text-xs text-gray-600 font-mono tracking-widest uppercase">Admin</span>
      <a href="/" class="text-xs text-gray-500 hover:text-white transition-colors duration-200">
        ← Back to site
      </a>
    </header>

    <div class="pt-14">
      <AdminAuth client:only="react" />
    </div>
  </body>
</html>
