---
import Layout from '../layouts/Layout.astro';
import DynamicBlogLoader from '../components/DynamicBlogLoader';
---

<Layout title="404 - Page Not Found">
  <div id="dynamic-content-container">

    <!-- Standard 404 content (shown by default) -->
    <div id="standard-404" class="min-h-screen bg-black flex flex-col items-center justify-center px-4 md:px-8 -mt-16">
      <div class="max-w-7xl mx-auto w-full text-center">
        <p class="text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm mb-8">Error</p>
        <h1 class="font-heading font-bold leading-none text-[20vw] text-white mb-6 tabular-nums">
          404
        </h1>
        <p class="text-gray-500 text-base md:text-lg max-w-md mx-auto mb-12 leading-relaxed">
          The page you're looking for doesn't exist or has been moved.
        </p>
        <a
          href="/"
          class="group inline-flex items-center gap-3 text-white text-sm font-medium hover:text-[#00f19f] transition-colors duration-300"
        >
          Return home
          <span class="w-10 h-10 rounded-full border border-white/30 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-500">
            <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Dynamic blog loader container (hidden by default) -->
    <div id="dynamic-blog-container" style="display: none;">
      <DynamicBlogLoader client:only="react" />
    </div>

  </div>
</Layout>

<script>
  function isBlogUrl() {
    const path = window.location.pathname;
    const blogPattern = /^\/resources\/([^\/]+)\/([^\/]+)\/?$/;
    return blogPattern.test(path);
  }

  document.addEventListener('DOMContentLoaded', function() {
    const standard404 = document.getElementById('standard-404');
    const dynamicBlogContainer = document.getElementById('dynamic-blog-container');

    if (isBlogUrl()) {
      if (standard404) standard404.style.display = 'none';
      if (dynamicBlogContainer) dynamicBlogContainer.style.display = 'block';
    } else {
      if (standard404) standard404.style.display = 'flex';
      if (dynamicBlogContainer) dynamicBlogContainer.style.display = 'none';
    }
  });
</script>
