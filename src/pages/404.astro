---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found">
  <main class="min-h-screen bg-black flex items-center justify-center -mt-20">
    <div class="text-center px-4">
      <h1 class="text-9xl font-bold text-green-500 mb-4 animate-pulse">404</h1>
      <h2 class="text-2xl md:text-4xl text-white font-bold mb-6">Page Not Found</h2>
      <p class="text-gray-400 mb-8 max-w-md mx-auto">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>
      <a 
        href="/" 
        class="inline-flex items-center justify-center px-8 py-3 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-all duration-300 transform hover:scale-105"
      >
        Return Home
      </a>
    </div>
  </main>
</Layout>
