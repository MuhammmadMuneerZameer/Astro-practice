---
import Layout from '../../layouts/Layout.astro';
import { SERVICE_HIERARCHY, getAllServices } from '../../data/taxonomy.js';

const services = getAllServices();
---

<Layout
  title="About Us | Hydra Fox Designs"
  description="Learn about Hydra Fox Designs - a strategic design agency building systems that scale and convert for ambitious brands."
>
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium">About</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-black text-white px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        We Build <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600">Profitable</span><br/>
        Digital Experiences.
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl leading-relaxed">
        Hydra Fox Designs is a strategic design agency that transforms brands through 
        conversion-focused design, development, and marketing.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-green-400 text-sm font-medium uppercase tracking-wider mb-4 block">Our Mission</span>
          <h2 class="text-4xl font-bold mb-6">Stop Losing Money to Poor Digital Experiences.</h2>
          <p class="text-gray-400 text-lg leading-relaxed mb-6">
            Too many businesses treat their website like a brochure instead of a business engine.
            We change that by building systems designed to convert, scale, and generate real ROI.
          </p>
          <p class="text-gray-400 text-lg leading-relaxed">
            Every design decision, every line of code, every marketing strategy is built around 
            one question: <strong class="text-white">Will this make money for our client?</strong>
          </p>
        </div>
        <div class="bg-gray-900/50 rounded-2xl p-8 border border-gray-800">
          <h3 class="text-2xl font-bold mb-6">What We Believe</h3>
          <ul class="space-y-4">
            <li class="flex gap-4">
              <span class="w-6 h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              </span>
              <span class="text-gray-300">Design without strategy is just decoration.</span>
            </li>
            <li class="flex gap-4">
              <span class="w-6 h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              </span>
              <span class="text-gray-300">Websites should pay for themselves within weeks, not years.</span>
            </li>
            <li class="flex gap-4">
              <span class="w-6 h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              </span>
              <span class="text-gray-300">Your brand is your most valuable asset. Treat it like one.</span>
            </li>
            <li class="flex gap-4">
              <span class="w-6 h-6 bg-green-500/10 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
              </span>
              <span class="text-gray-300">Confused customers don't buy. Clear messaging wins.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Our Expertise</h2>
      <p class="text-gray-400 mb-12">Full-stack brand and digital solutions.</p>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map(service => (
          <a 
            href={`/services/${service.slug}/`}
            class="group block p-5 bg-gray-900/30 rounded-lg border border-gray-800 hover:border-green-500/30 transition-all"
          >
            <h3 class="font-bold mb-2 group-hover:text-green-400 transition-colors">
              {service.name}
            </h3>
            <p class="text-gray-500 text-sm line-clamp-2">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-gradient-to-b from-black to-gray-900 text-white px-6 py-24 border-t border-gray-800">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Work With Us?</h2>
      <p class="text-gray-400 text-lg mb-10">
        Let's discuss how we can transform your digital presence.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-colors"
        >
          Get in Touch
        </a>
        <a 
          href="/work/"
          class="inline-flex items-center justify-center gap-2 px-10 py-4 border border-gray-600 hover:border-white text-white font-medium rounded-full transition-colors"
        >
          View Our Work
        </a>
      </div>
    </div>
  </section>
</Layout>
