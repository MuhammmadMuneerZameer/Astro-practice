---
import Layout from '../../layouts/Layout.astro';
import { getAllServices } from '../../data/taxonomy.js';

const services = getAllServices();
---

<Layout
  title="About | Hydra Fox Designs — DTC Growth Agency"
  description="Hydra Fox Designs is a DTC growth agency. We build Shopify stores, run paid media to MER targets, and implement Klaviyo retention systems for ecommerce brands that compete on contribution margin."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="about-hero relative min-h-[70vh] flex flex-col justify-end pb-20 px-4 md:px-8 bg-black overflow-hidden -mt-16 md:mt-0 pt-32 md:pt-40">
    <div class="absolute inset-0 bg-gradient-to-b from-[#00f19f]/5 to-transparent pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="overflow-hidden mb-4 flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="about-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          About Us
        </span>
        <span class="about-reveal-line block text-gray-600 font-mono text-xs tracking-wide">
          Karachi, Pakistan
        </span>
      </div>
      <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
        <div class="overflow-hidden">
          <span class="about-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            We Build
          </span>
        </div>
        <div class="overflow-hidden">
          <span class="about-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Profitable
          </span>
        </div>
        <div class="overflow-hidden">
          <span class="about-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Experiences.
          </span>
        </div>
      </h1>
      <div class="overflow-hidden max-w-2xl">
        <p class="about-reveal-fade text-gray-400 text-base md:text-lg font-light leading-relaxed mb-5">
          We are based in Karachi and we work with brands across Pakistan, the Gulf, the UK, and the US.
          That means you get senior people on your account instead of a junior team, at a rate that would
          buy you an account coordinator at a Western agency. We respond within 24 hours every working
          day — same-day for Gulf and UK clients.
        </p>
        <p class="about-reveal-fade text-gray-500 text-sm leading-relaxed border-l-2 border-[#00f19f]/40 pl-5 italic max-w-xl">
          We say this on the first page rather than the last, because you would find out anyway —
          and how a company handles the things it could have hidden tells you most of what you need
          to know about it.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Mission ───────────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section grid md:grid-cols-2 gap-16 items-start">
        <div>
          <div class="overflow-hidden mb-4">
            <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
              Our Mission
            </span>
          </div>
          <div class="overflow-hidden mb-8">
            <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-tight">
              Built for Operators, Not Browsers.
            </h2>
          </div>
          <p class="reveal-fade text-gray-400 text-base leading-relaxed mb-6">
            Ecommerce brands come to us when they've plateaued — when rising CPMs are
            compressing MER, when Klaviyo hasn't been touched since the store launched,
            when a slow Shopify theme is costing them conversion rate every day.
          </p>
          <p class="reveal-fade text-gray-400 text-base leading-relaxed">
            We fix the underlying infrastructure first. Then we grow on top of it. Every
            decision maps back to one number: <strong class="text-white">contribution margin</strong>.
          </p>
        </div>

        <div class="border-l-2 border-[#00f19f]/30 pl-8 md:pl-12">
          <div class="overflow-hidden mb-6">
            <h3 class="reveal-line block text-2xl font-heading font-bold text-white">What We Believe</h3>
          </div>
          <ul class="space-y-6">
            {[
              "MER is the metric that matters. Platform ROAS is a story platforms tell themselves.",
              "A 1% lift in conversion rate is worth more than a 10% increase in ad budget.",
              "Your brand is your margin premium. Without it, you compete on price forever.",
              "Accurate attribution is infrastructure. Conversions API is not optional."
            ].map((belief, i) => (
              <li class="reveal-fade flex items-start gap-4">
                <span class="text-[#00f19f] font-mono text-xs mt-1 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-gray-300 leading-relaxed">{belief}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services Overview ─────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <div class="overflow-hidden mb-4">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            Expertise
          </span>
        </div>
        <div class="overflow-hidden">
          <h2 class="reveal-line block text-5xl md:text-6xl font-heading font-bold text-white leading-none">Our Services.</h2>
        </div>
      </div>

      <div class="border-t border-white/10">
        {services.map((service, i) => (
          <a
            href={`/services/${service.slug}/`}
            class="group flex items-center gap-6 md:gap-10 py-6 border-b border-white/10 hover:border-white/30 transition-colors duration-300"
          >
            <span class="text-gray-600 text-xs font-mono w-8 flex-shrink-0 select-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="text-xl md:text-2xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors duration-300">
                {service.name}
              </h3>
              <p class="text-gray-500 text-sm mt-1 hidden sm:block line-clamp-1">{service.description}</p>
            </div>
            <span class="w-9 h-9 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300 flex-shrink-0">
              <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ── Team ──────────────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <div class="overflow-hidden mb-4">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            The Team
          </span>
        </div>
        <div class="overflow-hidden">
          <h2 class="reveal-line block text-5xl md:text-6xl font-heading font-bold text-white leading-none">
            Who's on your account.
          </h2>
        </div>
      </div>

      <!-- Working model callout -->
      <div class="reveal-fade border-l-4 border-[#00f19f] pl-8 mb-16 max-w-2xl">
        <p class="text-white text-lg md:text-xl leading-relaxed font-medium mb-3">
          You work directly with the founder. There is no account manager layer and no junior hand-off after the pitch.
        </p>
        <p class="text-gray-400 text-sm leading-relaxed">
          Muneer leads every client engagement — discovery, strategy, and weekly reporting. Farzam runs paid media execution across active accounts. The person who pitches is the person who delivers.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="reveal-fade group">
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-gray-900 mb-5">
            <img src="/images/muneer.png" alt="Muneer Zameer" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" width="400" height="533" loading="lazy" />
          </div>
          <h3 class="text-white font-heading font-bold text-xl">Muneer Zameer</h3>
          <p class="text-[#00f19f] text-xs font-bold tracking-[0.15em] uppercase mt-1">Founder & CEO</p>
          <p class="text-gray-500 text-sm mt-2 leading-relaxed">Leads every client account — discovery, strategy, and reporting. Your direct contact from day one.</p>
        </div>
        <div class="reveal-fade group">
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-gray-900 mb-5">
            <img src="/images/farzam.png" alt="Farzam Ahmed" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" width="400" height="533" loading="lazy" />
          </div>
          <h3 class="text-white font-heading font-bold text-xl">Farzam Ahmed</h3>
          <p class="text-[#00f19f] text-xs font-bold tracking-[0.15em] uppercase mt-1">Marketing Head</p>
          <p class="text-gray-500 text-sm mt-2 leading-relaxed">Paid media execution across Meta, Google, and TikTok — campaign management, creative testing, and MER reporting.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initAboutAnimations() {
    const lines = document.querySelectorAll('.about-reveal-line');
    const fades = document.querySelectorAll('.about-reveal-fade');

    lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    fades.forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lines.forEach((el, i) => {
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        fades.forEach((el, i) => {
          const anim = el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 500 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initAboutAnimations);
</script>

<style>
  .about-reveal-line { will-change: transform; }
  .about-reveal-fade { will-change: opacity; }
</style>
