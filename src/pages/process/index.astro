---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="How We Work | Hydra Fox Designs"
  description="Our engagement model for Shopify builds and growth retainers — what we deliver at each stage, what we need from you, and what is explicitly out of scope."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="relative bg-black overflow-hidden -mt-16 md:mt-0 pt-36 md:pt-52 pb-20 px-4 md:px-8 border-b border-white/10">
    <div class="absolute inset-0 bg-gradient-to-b from-green-900/5 to-transparent pointer-events-none" />
    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="overflow-hidden mb-4">
        <span class="proc-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          Engagement Model
        </span>
      </div>
      <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
        <div class="overflow-hidden">
          <span class="proc-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            How we work.
          </span>
        </div>
      </h1>
      <div class="overflow-hidden max-w-2xl">
        <p class="proc-reveal-fade text-gray-400 text-base md:text-lg font-light leading-relaxed">
          Scope ambiguity is the number one source of agency disputes. This page
          publishes exactly what we deliver, when we deliver it, what we need from
          you, and what is out of scope — so there are no surprises.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Two models ────────────────────────────────────────────────────────── -->
  <section class="bg-black border-b border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">Two engagement types</span>
        <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">Choose your model.</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-white/10">
        <div class="md:pr-12 pb-10 md:pb-0">
          <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-5">Model A</p>
          <h3 class="font-heading font-bold text-2xl text-white mb-3">Project — Store Design & Build</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            A fixed-scope, fixed-price Shopify build. One price, one deliverable, one end date. Ongoing support is opt-in after launch.
          </p>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">Fixed price from $4,500</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">5–6 week delivery</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">30-day bug-fix support included</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">No retainer obligation</span>
            </div>
          </div>
        </div>
        <div class="md:pl-12 pt-10 md:pt-0">
          <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-5">Model B</p>
          <h3 class="font-heading font-bold text-2xl text-white mb-3">Retainer — Growth Services</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            A monthly engagement for Ecommerce Growth, Growth Tools & Automation, or Brand & Content. Month-to-month. Cancel with 30 days' notice.
          </p>
          <div class="space-y-2 text-sm">
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">From $1,200–$2,500/mo depending on scope</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">Month 1 is onboarding + foundation</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">No minimum term</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0" />
              <span class="text-gray-300">Weekly reporting included</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Model A: Project timeline ─────────────────────────────────────────── -->
  <section class="bg-black border-b border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-14">
        <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-2">Model A</p>
        <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">Store Design & Build — Week by Week.</h2>
      </div>

      <div class="space-y-0">
        {[
          {
            week: 'Week 1',
            phase: 'Discovery',
            deliver: [
              'Scope document — every page, every feature, every integration named',
              'Shared Notion workspace with timeline, asset checklist, and approval log',
              '60-minute kickoff call recorded and shared',
            ],
            need: [
              'Shopify admin access within 48 hours of contract signing',
              'Brand assets: logo files, colours, fonts, any existing guidelines',
              'Three competitor stores you respect (helps calibrate design direction)',
              'Named single point of contact for approvals',
            ],
          },
          {
            week: 'Weeks 2–3',
            phase: 'Design',
            deliver: [
              'Wireframes for homepage, PDP, collection page, and cart',
              'One round of revisions per page included',
              'Mobile-first — desktop follows mobile, not the reverse',
            ],
            need: [
              'Written copy for all pages (product descriptions, hero text, about section)',
              'Product photography or brand imagery at final resolution',
              'Feedback within 48 hours of each design delivery',
            ],
          },
          {
            week: 'Weeks 3–5',
            phase: 'Build',
            deliver: [
              'Full Shopify theme build in a password-protected dev environment',
              'Conversions API (server-side tracking) configured before launch',
              'Core Web Vitals passing on mobile before handover — LCP under 2.5s',
              'GA4 and Meta Pixel verified against the approved scope',
            ],
            need: [
              'Meta Business Manager access to configure CAPI',
              'Google Analytics and Google Tag Manager access',
              'Any third-party app subscriptions needed for scope features',
            ],
          },
          {
            week: 'Weeks 5–6',
            phase: 'QA & Launch',
            deliver: [
              'Staging link for 3-business-day client review',
              'Bug fixes for any deviation from the approved design',
              'Launch checklist completed and signed off',
              'DNS cutover managed by us at a time you choose',
              'Post-launch monitoring for 72 hours',
            ],
            need: [
              'Domain access or DNS login credentials',
              'Written launch sign-off before go-live',
              'Confirmation of launch timing (avoid launch before weekends)',
            ],
          },
          {
            week: 'Days 1–30 post-launch',
            phase: 'Included Support',
            deliver: [
              'Bug fixes for issues that appear post-launch (functionality deviations from scope)',
              'Response within 24 business hours',
              'One month of Slack access to the build team',
            ],
            need: [
              'Issues reported with screen recording or screenshot — no phone calls for bugs',
            ],
          },
        ].map(({ week, phase, deliver, need }, i) => (
          <div class="grid md:grid-cols-[180px_1fr_1fr] gap-6 md:gap-10 py-10 border-t border-white/10 reveal-fade">
            <div class="flex-shrink-0">
              <p class="text-[#00f19f] font-mono text-xs tracking-widest uppercase">{week}</p>
              <p class="text-white font-heading font-bold text-lg mt-1">{phase}</p>
            </div>
            <div>
              <p class="text-gray-600 text-[10px] font-mono tracking-widest uppercase mb-3">We deliver</p>
              <ul class="space-y-2">
                {deliver.map((d) => (
                  <li class="flex items-start gap-3 text-gray-400 text-sm">
                    <span class="w-1 h-1 rounded-full bg-[#00f19f] flex-shrink-0 mt-1.5" />
                    {d}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-gray-600 text-[10px] font-mono tracking-widest uppercase mb-3">We need from you</p>
              <ul class="space-y-2">
                {need.map((n) => (
                  <li class="flex items-start gap-3 text-gray-400 text-sm">
                    <span class="w-1 h-1 rounded-full bg-white/20 flex-shrink-0 mt-1.5" />
                    {n}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Model B: Retainer ─────────────────────────────────────────────────── -->
  <section class="bg-black border-b border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-14">
        <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-2">Model B</p>
        <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">Growth Retainer — Month by Month.</h2>
      </div>

      <!-- Month 1 onboarding -->
      <div class="mb-16">
        <p class="text-[#00f19f] font-mono text-xs tracking-widest uppercase mb-6">Month 1 — Foundation</p>
        <div class="grid md:grid-cols-4 gap-0 divide-y md:divide-y-0 md:divide-x divide-white/10">
          {[
            { wk: 'Week 1', items: ['Platform access secured', 'Tracking audit completed', 'Conversions API live before any paid campaign runs', 'Baseline metrics document delivered'] },
            { wk: 'Week 2', items: ['Ad account audit', 'Klaviyo flow audit (if in scope)', 'Competitor ad creative research', 'First creative brief issued'] },
            { wk: 'Week 3', items: ['Campaign restructure in staging', 'Creative assets in production', 'MER dashboard built in your reporting tool'] },
            { wk: 'Week 4', items: ['Restructured campaigns launched', 'First weekly MER report sent', 'Month 1 review call booked'] },
          ].map(({ wk, items }, i) => (
            <div class={`py-6 ${i === 0 ? 'md:pr-8' : i === 3 ? 'md:pl-8' : 'md:px-8'}`}>
              <p class="text-white font-medium text-sm mb-4">{wk}</p>
              <ul class="space-y-2">
                {items.map((item) => (
                  <li class="flex items-start gap-2 text-gray-500 text-xs leading-relaxed">
                    <span class="w-1 h-1 rounded-full bg-[#00f19f] flex-shrink-0 mt-1.5" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Ongoing cadence -->
      <div class="grid md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-white/10">
        <div class="md:pr-12 pb-12 md:pb-0">
          <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-6">Included every month</p>
          <ul class="space-y-4">
            {[
              ['Weekly MER report', 'Delivered every Monday morning. Blended CAC, MER, AOV, and spend by channel. No platform ROAS figures — only numbers that map to margin.'],
              ['Monthly strategy call', '60-minute video call. Previous month review, next month plan, open questions. Recorded and shared.'],
              ['Creative production', 'Ad creative brief, production, and upload. Number of assets per month agreed in scope.'],
              ['Klaviyo management', 'Flow updates, A/B tests on subject lines and send times, list health maintenance.'],
              ['Direct access', 'Slack or WhatsApp channel. Response within 4 business hours during Karachi business hours (9am–7pm PKT).'],
            ].map(([title, desc]) => (
              <li class="border-b border-white/5 pb-4 last:border-0 last:pb-0">
                <p class="text-white text-sm font-medium mb-1">{title}</p>
                <p class="text-gray-500 text-xs leading-relaxed">{desc}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="md:pl-12 pt-12 md:pt-0">
          <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-6">Not included in retainer</p>
          <ul class="space-y-4">
            {[
              ['Ad spend', 'You pay the platforms directly. We never hold your ad spend.'],
              ['New page builds', 'Landing pages or store sections outside the original retainer scope are quoted as add-on projects.'],
              ['Product photography', 'Unless Brand & Content is in scope, photography is your responsibility.'],
              ['Copywriting', 'Page copy, product descriptions, and email copy are client-provided unless copywriting is explicitly in scope.'],
              ['Third-party app fees', 'Klaviyo, Gorgias, Recharge, and any other platform subscriptions are billed directly to you.'],
            ].map(([title, desc]) => (
              <li class="border-b border-white/5 pb-4 last:border-0 last:pb-0">
                <p class="text-white text-sm font-medium mb-1">{title}</p>
                <p class="text-gray-500 text-xs leading-relaxed">{desc}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What we need from every client ────────────────────────────────────── -->
  <section class="bg-black border-b border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">What we need from every client.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            num: '01',
            title: 'One named contact',
            desc: 'A single person with authority to approve work. Multiple approval chains slow every project and no agency can protect a timeline when it does not know whose feedback is final.',
          },
          {
            num: '02',
            title: '48-hour feedback window',
            desc: 'Feedback within two business days of each delivery. If we do not hear back within 48 hours, we treat the deliverable as approved and continue to the next phase.',
          },
          {
            num: '03',
            title: 'Platform access on day one',
            desc: 'Shopify, Meta Business Manager, Google Ads, Klaviyo — all access granted within 48 hours of contract signing. Projects that start without access do not start on time.',
          },
          {
            num: '04',
            title: 'Assets before the build starts',
            desc: 'Logo files, brand colours and fonts, product images, and any existing copy delivered in week one. We cannot design around assets that have not arrived.',
          },
          {
            num: '05',
            title: 'Written approvals',
            desc: 'All change requests and approvals in writing — Notion, Slack, or email. Phone calls are for discussion. Decisions must be confirmed in text so both sides have a clear record.',
          },
          {
            num: '06',
            title: 'Honest numbers',
            desc: 'Accurate ad spend history, real conversion rate data, and actual COGS. We build strategy against your numbers, not our assumptions. Bad inputs produce bad outputs.',
          },
        ].map(({ num, title, desc }) => (
          <div class="reveal-fade border-t border-white/10 pt-6">
            <p class="text-gray-700 font-mono text-xs mb-4">{num}</p>
            <h3 class="font-heading font-bold text-lg text-white mb-3">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Out of scope ───────────────────────────────────────────────────────── -->
  <section class="bg-black border-b border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto grid md:grid-cols-[1fr_2fr] gap-12 md:gap-20">
      <div>
        <h2 class="font-heading font-bold text-4xl md:text-5xl text-white leading-none mb-4">Out of scope.</h2>
        <p class="text-gray-500 text-sm leading-relaxed">
          This list exists to prevent misunderstandings, not to limit what we can do.
          Everything below can be added as a separate scope item — it simply is not
          included by default.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-6">
        {[
          'Copywriting and content writing (page copy, product descriptions, blog posts)',
          'Legal and compliance review (terms of service, GDPR, CCPA)',
          'Product photography and video production (unless Brand & Content is in scope)',
          'Fulfilment, warehousing, and logistics',
          'Customer service and live chat management',
          'Ongoing SEO content production (quoted as a separate retainer)',
          'Custom Shopify app development outside agreed scope',
          'Social media community management',
          'Influencer sourcing and management',
          'Domain registration and ongoing hosting fees (you own these directly)',
        ].map((item) => (
          <div class="flex items-start gap-3 text-sm text-gray-500 reveal-fade">
            <span class="w-1 h-1 rounded-full bg-white/20 flex-shrink-0 mt-2" />
            {item}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="bg-black px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-[#00f19f] text-xs font-bold tracking-[0.2em] uppercase mb-6">Ready to start?</p>
      <h2 class="font-heading font-bold text-4xl md:text-6xl text-white mb-4">
        Tell us what you need.
      </h2>
      <p class="text-gray-500 text-sm mb-12 max-w-md mx-auto">
        We'll confirm scope, timeline, and price in the proposal — usually within 48 hours of your brief.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="/contact/" class="group inline-flex items-center gap-4 text-white">
          <span class="w-14 h-14 rounded-full border-2 border-white/30 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-500">
            <svg class="w-5 h-5 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
          <span class="font-heading font-bold text-2xl group-hover:text-[#00f19f] transition-colors duration-300">Send a brief</span>
        </a>
        <a href="https://cal.com/hydra-fox-sqrqbz/30min" target="_blank" rel="noopener noreferrer"
           class="text-gray-500 hover:text-white text-sm font-mono transition-colors duration-300">
          or book a 30-min call →
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initProcessAnimations() {
    document.querySelectorAll('.proc-reveal-line').forEach(el => {
      el.style.transform = 'translateY(110%)';
    });
    document.querySelectorAll('.proc-reveal-fade').forEach(el => {
      el.style.opacity = '0';
    });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.proc-reveal-line').forEach((el, i) => {
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        document.querySelectorAll('.proc-reveal-fade').forEach((el, i) => {
          const anim = el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 500 + i * 80, easing: CUBIC_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
      });
    });

    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.querySelectorAll('.reveal-line').forEach((el, i) => {
          el.style.transform = 'translateY(110%)';
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        entry.target.querySelectorAll('.reveal-fade').forEach((el, i) => {
          el.animate(
            [{ opacity: '0', transform: 'translateY(20px)' }, { opacity: '1', transform: 'translateY(0)' }],
            { duration: 700, delay: i * 60, easing: CUBIC_OUT, fill: 'forwards' }
          );
        });
        io.unobserve(entry.target);
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.reveal-line').forEach(el => {
      el.style.transform = 'translateY(110%)';
    });
    document.querySelectorAll('.reveal-fade').forEach(el => {
      el.style.opacity = '0';
    });

    document.querySelectorAll('section:not(:first-of-type)').forEach(s => io.observe(s));
  }

  document.addEventListener('astro:page-load', initProcessAnimations);
</script>

<style>
  .proc-reveal-line,
  .reveal-line { will-change: transform; display: block; }
  .proc-reveal-fade,
  .reveal-fade { will-change: opacity; }
</style>
