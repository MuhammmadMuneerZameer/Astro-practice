---
import Layout from '../../layouts/Layout.astro';
import { getAllIndustries, getAllServices } from '../../data/taxonomy.js';
import { getCaseStudies } from '../../data/caseStudies.js';

const industries = getAllIndustries();
const services = getAllServices();
const caseStudies = await getCaseStudies();
---

<Layout
  title="Industries We Serve | Hydra Fox Designs"
  description="Specialized branding, design, and marketing expertise for home decor, real estate, food & beverage, and startups."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="ind-hero relative min-h-[60vh] flex flex-col justify-end pb-16 px-4 md:px-8 bg-black overflow-hidden -mt-16 md:mt-0 pt-32 md:pt-40">
    <div class="absolute inset-0 bg-gradient-to-b from-[#00f19f]/5 to-transparent pointer-events-none"></div>
    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="overflow-hidden mb-4">
        <span class="ind-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          Industries
        </span>
      </div>
      <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
        <div class="overflow-hidden">
          <span class="ind-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Industries We
          </span>
        </div>
        <div class="overflow-hidden">
          <span class="ind-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Specialize In.
          </span>
        </div>
      </h1>
      <div class="overflow-hidden max-w-2xl">
        <p class="ind-reveal-fade text-gray-400 text-base md:text-lg font-light leading-relaxed">
          We don't apply templates. We understand the unique challenges, opportunities,
          and customer psychology of your specific market.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Industries List ───────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <div class="overflow-hidden mb-4">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            Our Verticals
          </span>
        </div>
        <div class="overflow-hidden">
          <h2 class="reveal-line block text-5xl md:text-6xl font-heading font-bold text-white leading-none">Our Markets.</h2>
        </div>
      </div>

      <div class="border-t border-white/10">
        {industries.map((industry, i) => {
          const count = caseStudies.filter(cs => cs.industry === industry.slug).length;
          return (
            <a
              href={`/industries/${industry.slug}/`}
              class="group flex items-start gap-6 md:gap-10 py-8 border-b border-white/10 hover:border-white/30 transition-colors duration-300"
            >
              <span class="text-gray-600 text-xs font-mono w-8 flex-shrink-0 mt-1.5 select-none">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="flex-1 min-w-0">
                <h2 class="text-2xl md:text-3xl lg:text-4xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors duration-300 mb-2">
                  {industry.name}
                </h2>
                <p class="text-gray-500 text-sm leading-relaxed hidden sm:block line-clamp-2">{industry.description}</p>
              </div>
              {count > 0 && (
                <span class="hidden md:flex px-3 py-1 bg-[#00f19f]/10 border border-[#00f19f]/20 text-[#00f19f] text-xs font-bold rounded-full flex-shrink-0 mt-1">
                  {count} {count === 1 ? 'project' : 'projects'}
                </span>
              )}
              <span class="w-9 h-9 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300 flex-shrink-0 mt-1">
                <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Services Grid ─────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <div class="overflow-hidden mb-4">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            Our Services
          </span>
        </div>
        <div class="overflow-hidden">
          <h2 class="reveal-line block text-5xl md:text-6xl font-heading font-bold text-white leading-none">Every Industry Benefits.</h2>
        </div>
      </div>

      <div class="border-t border-white/10">
        {services.map((service, i) => (
          <a
            href={`/services/${service.slug}/`}
            class="group flex items-center gap-6 md:gap-10 py-6 border-b border-white/10 hover:border-white/30 transition-colors duration-300"
          >
            <span class="text-gray-600 text-xs font-mono w-8 flex-shrink-0 select-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="text-xl md:text-2xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors duration-300">
                {service.name}
              </h3>
              <p class="text-gray-500 text-sm mt-1 hidden sm:block line-clamp-1">{service.description}</p>
            </div>
            <span class="w-9 h-9 rounded-full border border-white/20 group-hover:border-[#00f19f] group-hover:bg-[#00f19f] flex items-center justify-center transition-all duration-300 flex-shrink-0">
              <svg class="w-4 h-4 text-white group-hover:text-black -rotate-45 group-hover:rotate-0 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initIndAnimations() {
    const lines = document.querySelectorAll<HTMLElement>('.ind-reveal-line');
    const fades = document.querySelectorAll<HTMLElement>('.ind-reveal-fade');

    lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    fades.forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lines.forEach((el, i) => {
          el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
        });
        fades.forEach((el, i) => {
          el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 400 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
          );
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initIndAnimations);
  document.addEventListener('astro:page-load', initIndAnimations);
</script>

<style>
  .ind-reveal-line { will-change: transform; }
  .ind-reveal-fade { will-change: opacity; }
</style>
