---
import Layout from '../../layouts/Layout.astro';
import { INDUSTRIES, getAllIndustries, SERVICE_HIERARCHY } from '../../data/taxonomy.js';
import { getCaseStudies } from '../../data/caseStudies.js';

const industries = getAllIndustries();
const services = Object.values(SERVICE_HIERARCHY);
const caseStudies = await getCaseStudies();
---

<Layout
  title="Industries We Serve | Hydra Fox Designs"
  description="Specialized branding, design, and marketing expertise for home decor, real estate, food & beverage, and startups."
>
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium">Industries</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-black text-white px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        Industries We <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600">Specialize In</span>
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl leading-relaxed">
        We don't just apply templates. We understand the unique challenges, opportunities, 
        and customer psychology of your specific market.
      </p>
    </div>
  </section>

  <!-- Industries Grid -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">
        {industries.map(industry => {
          const industryCaseStudies = caseStudies.filter(cs => cs.industry === industry.slug).slice(0, 2);
          
          return (
            <a 
              href={`/industries/${industry.slug}/`}
              class="group block p-8 bg-gray-900/50 rounded-2xl border border-gray-800 hover:border-green-500/50 transition-all duration-300"
            >
              <h2 class="text-3xl font-bold mb-4 group-hover:text-green-400 transition-colors">
                {industry.name}
              </h2>
              <p class="text-gray-400 mb-6 leading-relaxed">
                {industry.description}
              </p>
              
              {/* Key Challenges */}
              <div class="mb-6">
                <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider mb-3">Key Challenges</h3>
                <ul class="space-y-2">
                  {industry.challenges.slice(0, 2).map(challenge => (
                    <li class="flex items-start gap-2 text-gray-300 text-sm">
                      <span class="w-1.5 h-1.5 rounded-full bg-green-500 mt-2 flex-shrink-0"></span>
                      {challenge}
                    </li>
                  ))}
                </ul>
              </div>
              
              <div class="flex items-center gap-2 text-green-400 font-medium">
                <span>Explore {industry.name}</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Services CTA -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Our Services</h2>
      <p class="text-gray-400 mb-12">Every industry benefits from our core capabilities.</p>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {services.map(service => (
          <a 
            href={`/services/${service.slug}/`}
            class="group block p-5 bg-gray-900/30 rounded-lg border border-gray-800 hover:border-green-500/30 transition-all"
          >
            <h3 class="font-bold mb-2 group-hover:text-green-400 transition-colors">
              {service.name}
            </h3>
            <p class="text-gray-500 text-sm line-clamp-2">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-b from-black to-gray-900 text-white px-6 py-24 border-t border-gray-800">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Don't See Your Industry?</h2>
      <p class="text-gray-400 text-lg mb-10">
        We work with businesses across many sectors. Let's discuss your specific needs.
      </p>
      <a 
        href="/contact/"
        class="inline-flex items-center gap-2 px-10 py-4 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
