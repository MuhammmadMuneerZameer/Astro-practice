---
import Layout from "../../layouts/Layout.astro";
import {
  INDUSTRIES,
  SERVICE_HIERARCHY,
  getIndustryBySlug,
} from "../../data/taxonomy.js";
import { getCaseStudies } from "../../data/caseStudies.js";

export function getStaticPaths() {
  return Object.keys(INDUSTRIES).map((industrySlug) => ({
    params: { industry: industrySlug },
  }));
}

const { industry: industrySlug } = Astro.params;
const industry = getIndustryBySlug(industrySlug);

if (!industry) {
  return Astro.redirect("/industries/");
}

const services = Object.values(SERVICE_HIERARCHY);
const allCaseStudies = await getCaseStudies();
const industryCaseStudies = allCaseStudies.filter(
  (cs) => cs.industry === industrySlug,
);
const otherIndustries = Object.values(INDUSTRIES).filter(
  (ind) => ind.slug !== industrySlug,
);
---

<Layout
  title={`${industry.name} | Hydra Fox Designs`}
  description={industry.description}
>
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li>
          <a href="/industries/" class="hover:text-white transition-colors"
            >Industries</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium">{industry.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-black text-white px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <span
        class="inline-block px-4 py-2 bg-blue-500/10 text-blue-400 rounded-full text-sm font-medium mb-6 border border-blue-500/20"
      >
        Industry Focus
      </span>
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        {industry.name}
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl leading-relaxed">
        {industry.description}
      </p>
    </div>
  </section>

  <!-- Challenges -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Challenges in {industry.name}</h2>
      <p class="text-gray-400 mb-12">
        We understand the unique hurdles facing {industry.name.toLowerCase()}.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        {
          industry.challenges.map((challenge: string, index: number) => (
            <div class="p-6 bg-gray-900/50 rounded-xl border border-gray-800">
              <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-4">
                <span class="text-blue-400 font-bold text-xl">{index + 1}</span>
              </div>
              <p class="text-gray-300 leading-relaxed">{challenge}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services for This Industry -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">How We Help {industry.name}</h2>
      <p class="text-gray-400 mb-12">
        Our services adapted for your industry's specific needs.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        {
          services.map((service) => (
            <a
              href={`/services/${service.slug}/`}
              class="group block p-6 bg-gray-900/50 rounded-xl border border-gray-800 hover:border-green-500/50 transition-all"
            >
              <h3 class="text-xl font-bold mb-3 group-hover:text-green-400 transition-colors">
                {service.name} for {industry.name}
              </h3>
              <p class="text-gray-400 leading-relaxed mb-4">
                {service.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {Object.values(service.subservices)
                  .slice(0, 3)
                  .map((sub) => (
                    <span class="px-2 py-1 bg-gray-800 text-gray-400 rounded text-xs">
                      {sub.name}
                    </span>
                  ))}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  {
    industryCaseStudies.length > 0 && (
      <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold mb-4">{industry.name} Case Studies</h2>
          <p class="text-gray-400 mb-12">
            See our work with {industry.name.toLowerCase()}.
          </p>

          <div class="grid md:grid-cols-3 gap-8">
            {industryCaseStudies.slice(0, 3).map((cs) => (
              <a href={`/work/${cs.slug}/`} class="group block">
                <div class="aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-gray-900">
                  <img
                    src={cs.image}
                    alt={cs.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <h3 class="text-lg font-bold group-hover:text-green-400 transition-colors">
                  {cs.title}
                </h3>
                <p class="text-gray-400 text-sm mt-1">{cs.client}</p>
              </a>
            ))}
          </div>

          <div class="mt-12 text-center">
            <a
              href="/work/"
              class="inline-flex items-center gap-2 px-6 py-3 border border-green-500 text-green-400 hover:bg-green-500 hover:text-black font-medium rounded-full transition-all"
            >
              View All Work
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Other Industries -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-2xl font-bold mb-8">Other Industries We Serve</h2>

      <div class="flex flex-wrap gap-3">
        {
          otherIndustries.map((ind) => (
            <a
              href={`/industries/${ind.slug}/`}
              class="px-5 py-3 bg-gray-900 hover:bg-gray-800 rounded-lg text-gray-300 hover:text-white transition-colors"
            >
              {ind.name}
            </a>
          ))
        }
      </div>

      <div class="mt-8">
        <a
          href="/industries/"
          class="text-green-400 hover:text-green-300 font-medium flex items-center gap-2"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to All Industries
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    class="bg-gradient-to-b from-black to-gray-900 text-white px-6 py-24 border-t border-gray-800"
  >
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">
        Ready to Stand Out in {industry.name}?
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        Let's create a brand and digital presence that dominates your market.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 px-10 py-4 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-colors"
      >
        Start Your Project
      </a>
    </div>
  </section>
</Layout>
