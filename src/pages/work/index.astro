---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from 'astro:content';
import WorkListAnimated from "../../components/WorkListAnimated";
import MouseTrail from "../../components/MouseTrail";

const entries = await getCollection('case-studies');
const caseStudies = entries.map((e) => ({
  id:       e.slug,
  slug:     e.slug,
  title:    e.data.title,
  client:   e.data.client,
  industry: e.data.industry,
  services: e.data.services,
  image:    e.data.image ?? '/images/desktop-opt.webp',
  featured: e.data.featured,
  isOwnBrand: e.data.isOwnBrand,
}));
---

<Layout
  title="Client Work | Hydra Fox Designs"
  description="Shopify builds, paid media campaigns, and Klaviyo retention programs — real results for DTC brands, measured in MER, CAC, and LTV:CAC."
>
  <MouseTrail
    client:only="react"
    images={[
      '/images/PNS%20image.jpg',
      '/images/websiteUI.webp',
      '/images/rabbi-estate-opt.webp',
      '/images/puchlo-pakistan-opt.webp',
      '/images/mockup.png',
      '/images/mobileUI.png',
      '/images/laptop.jpg',
    ]}
  />

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="work-hero relative min-h-[60vh] flex flex-col justify-end pb-16 px-4 md:px-8 bg-black overflow-hidden -mt-16 md:mt-0 pt-32 md:pt-40">
    <div class="absolute inset-0 bg-gradient-to-b from-green-900/5 to-transparent pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="overflow-hidden mb-4">
        <span class="work-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          Client Results
        </span>
      </div>
      <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
        <div class="overflow-hidden">
          <span class="work-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Real Brands.
          </span>
        </div>
        <div class="overflow-hidden">
          <span class="work-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Real Numbers.
          </span>
        </div>
      </h1>
      <div class="flex flex-col sm:flex-row sm:items-end gap-6">
        <div class="overflow-hidden flex-1">
          <p class="work-reveal-fade text-gray-400 text-base md:text-lg max-w-xl font-light">
            Every project here includes the baseline metrics we started with,
            what we changed, and what moved — in MER, CAC, or LTV:CAC.
          </p>
        </div>
        <div class="overflow-hidden flex-shrink-0">
          <p class="work-reveal-fade text-[#00f19f] font-mono text-sm">
            {caseStudies.length} project{caseStudies.length !== 1 ? 's' : ''}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Split-panel animated list ────────────────────────────────────────── -->
  <WorkListAnimated client:load initialCaseStudies={caseStudies as any} />

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initWorkAnimations() {
    const lines = document.querySelectorAll('.work-reveal-line');
    const fades = document.querySelectorAll('.work-reveal-fade');

    lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    fades.forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lines.forEach((el, i) => {
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        fades.forEach((el, i) => {
          const anim = el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 400 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initWorkAnimations);
</script>

<style>
  .work-reveal-line { will-change: transform; }
  .work-reveal-fade { will-change: opacity; }
</style>
