        <p class="text-gray-600 font-mono text-xs tracking-widest uppercase mb-6">Contract terms</p>
        <div class="space-y-5">
          {[
            ['Month-to-month', 'No minimum term on any retainer.'],
            ['30 days’ notice', 'Cancel any retainer with 30 days’ written notice. No penalty.'],
            ['Fixed-price builds', 'One price agreed in writing before any work begins. No scope creep billed silently.'],
            ['No lock-in', 'We keep clients through results, not contracts. If the results are not there, you should leave — and we’ll say so.'],
