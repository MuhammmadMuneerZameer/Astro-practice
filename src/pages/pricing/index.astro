<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initPricingAnimations() {
    document.querySelectorAll('.pr-reveal-line').forEach(el => { el.style.transform = 'translateY(110%)'; });
    document.querySelectorAll('.pr-reveal-fade').forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.pr-reveal-line').forEach((el, i) => {
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        document.querySelectorAll('.pr-reveal-fade').forEach((el, i) => {
          const anim = el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 400 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
      });
    });

    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.querySelectorAll('.reveal-line').forEach((el, i) => {
          el.style.transform = 'translateY(110%)';
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        io.unobserve(entry.target);
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.scroll-section').forEach(s => io.observe(s));
  }

  document.addEventListener('astro:page-load', initPricingAnimations);
</script>

<style>
  .pr-reveal-line, .reveal-line { will-change: transform; display: block; }
  .pr-reveal-fade { will-change: opacity; }
</style>
