---
import Layout from '../../layouts/Layout.astro';

const notIncluded = [
  'Ad spend — paid directly to the platform (Meta, Google, TikTok)',
  'Third-party software subscriptions (Klaviyo, Shopify apps)',
  'Paid theme licences or premium template fees',
  'Stock photography or licensed creative assets',
  'App subscription costs or third-party integration fees',
  'Work outside the agreed monthly scope — always quoted before it starts',
];

const faqs = [
  {
    q: 'Do prices change after the first month?',
    a: 'The starting price is the minimum scope. If the engagement grows — more ad spend to manage, more platforms, additional flows — we scope and price the expansion before starting. Nothing is added silently.',
  },
  {
    q: 'Can I start with just one service?',
    a: "Yes. Most clients start with either the Shopify build or the Ecommerce Growth retainer, then add services once the baseline is established. We don't require bundling.",
  },
  {
    q: 'What does the onboarding process look like?',
    a: 'One 30-minute call, then we need ad account access, Shopify admin, and Klaviyo access. No strategy briefs, no lengthy discovery. Server-side tracking is live in week one.',
  },
];
---

<Layout
  title="Pricing | Hydra Fox Designs"
  description="We publish our prices because it saves everyone the wrong call. Shopify builds from $4,500. Ecommerce Growth retainer from $2,500/mo. Month-to-month. 30 days' notice. No lock-in."
>
