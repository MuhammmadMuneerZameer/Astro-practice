            <div class="flex items-start gap-4">
              <span class="w-1.5 h-1.5 rounded-full bg-[#00f19f] flex-shrink-0 mt-2" />
              <div>
                <p class="text-white text-sm font-semibold mb-0.5">{term}</p>
