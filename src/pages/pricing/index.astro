    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a }
    }))
  })} slot="head" />

  <!-- ── Hero — why we publish prices ─────────────────────────────────────── -->
  <section class="relative bg-black overflow-hidden -mt-16 md:mt-0 pt-36 md:pt-52 pb-24 px-4 md:px-8 border-b border-white/10">
    <div class="absolute inset-0 bg-gradient-to-b from-green-900/5 to-transparent pointer-events-none" />
    <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-end">
      <div>
        <div class="overflow-hidden mb-4">
          <span class="pr-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
            Transparent pricing
          </span>
        </div>
        <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
          <div class="overflow-hidden">
            <span class="pr-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
              No surprises.
            </span>
          </div>
        </h1>
        <div class="overflow-hidden max-w-xl">
          <p class="pr-reveal-fade text-gray-400 text-base md:text-lg font-light leading-relaxed">
