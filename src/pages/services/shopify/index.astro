---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('case-studies');
const caseStudies = entries
  .filter((e) => e.data.services?.some((s: string) => s === 'store-design-build'))
  .slice(0, 2)
  .map((e) => ({
    slug:  e.slug,
    title: e.data.title,
    client: e.data.client,
    image: e.data.image ?? '/images/desktop-opt.webp',
  }));

const deliverables = [
  {
    num: '01',
    name: 'Custom Theme Build',
    desc: 'Purpose-built Shopify theme designed around your brand and your conversion goals — not a template with your logo dropped in. Mobile-first, with pixel-accurate implementation of your design system.',
  },
  {
    num: '02',
    name: 'Shopify Plus & Checkout',
    desc: 'Checkout customisation available on Shopify Plus — custom fields, upsell blocks, and post-purchase pages that increase AOV without adding friction to the payment flow.',
  },
  {
    num: '03',
    name: 'Store Migration',
    desc: 'Full migration from WooCommerce, Squarespace, or any other platform to Shopify — products, collections, customer records, and URL redirects — without downtime or lost rankings.',
  },
  {
    num: '04',
    name: 'Speed & Core Web Vitals',
    desc: 'LCP, CLS, and FID optimisation built into the build from the start — not retrofitted. A 1-second delay in mobile load time reduces conversion by 20%. We target sub-2.5s LCP on every build.',
  },
  {
    num: '05',
    name: 'UX & CRO Design',
    desc: 'PDP layout, collection filtering, search UX, and cart behaviour designed to reduce drop-off — informed by Shopify conversion benchmarks for your category.',
  },
  {
    num: '06',
    name: 'CMS Handover',
    desc: "Video walkthroughs of every section you'll manage. You should be able to update products, collections, and homepage content without asking us first.",
  },
];

const siblings = [
  { label: 'Ecommerce Growth',     href: '/services/ecommerce-growth/' },
  { label: 'Growth Tools',         href: '/services/growth-tools/' },
  { label: 'Brand & Content',      href: '/services/brand-content/' },
];
---

<Layout
  title="Shopify & Shopify Plus Development | Hydra Fox Designs"
  description="Custom Shopify store builds, migrations, and CRO-optimised themes for DTC brands. Mobile-first, Core Web Vitals compliant, from $4,500."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://hydrafoxdesigns.com/" },
          { "@type": "ListItem", position: 2, name: "Services", item: "https://hydrafoxdesigns.com/services/" },
          { "@type": "ListItem", position: 3, name: "Shopify Stores", item: "https://hydrafoxdesigns.com/services/shopify/" },
        ]
      },
      {
        "@type": "Service",
        "@id": "https://hydrafoxdesigns.com/services/shopify/#service",
        name: "Shopify Store Build",
        provider: { "@id": "https://hydrafoxdesigns.com/#organization" },
        description: "Custom Shopify store builds, migrations, and CRO-optimised themes for DTC brands. Mobile-first, Core Web Vitals compliant.",
        offers: { "@type": "Offer", price: "4500", priceCurrency: "USD", priceSpecification: { "@type": "UnitPriceSpecification", priceType: "https://schema.org/MinimumAdvertisedPrice" } },
        areaServed: ["PK", "AE", "SA", "GB", "US"],
        url: "https://hydrafoxdesigns.com/services/shopify/",
      }
    ]
  })} slot="head" />

  <!-- ── Breadcrumb ────────────────────────────────────────────────────────── -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-700">/</li>
        <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
        <li class="text-gray-700">/</li>
        <li class="text-white font-medium">Shopify Stores</li>
      </ol>
    </div>
  </nav>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="bg-black text-white px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <span class="px-3 py-1 bg-green-500/10 text-green-400 rounded-full text-xs font-medium border border-green-500/20">
          Shopify & Shopify Plus
        </span>
      </div>
      <h1 class="text-5xl md:text-7xl font-heading font-bold mb-6 leading-none">
        Stores built to convert.
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl leading-relaxed">
        Custom Shopify builds engineered for mobile conversion rate, Core Web Vitals, and a post-purchase experience that increases LTV. Starting from $4,500 — fixed price, no ongoing fee.
      </p>
    </div>
  </section>

  <!-- ── Deliverables ──────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section mb-12">
        <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">What we build</span>
        <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">What does a Shopify store build include?</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-0">
        {deliverables.map((d) => (
          <div class="border-t border-white/10 py-8 md:pr-12 even:md:pl-12 even:md:border-l even:border-white/10">
            <p class="text-gray-700 font-mono text-xs mb-3">{d.num}</p>
            <h3 class="font-heading font-bold text-xl text-white mb-3">{d.name}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Stats strip ───────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-16">
    <div class="max-w-7xl mx-auto">
      <div class="scroll-section grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-white/10">
        {[
          { stat: '5–6', label: 'Week delivery timeline' },
          { stat: '<2.5s', label: 'Target LCP on mobile' },
          { stat: '30-day', label: 'Bug-fix support included' },
        ].map(({ stat, label }) => (
          <div class="py-8 sm:px-10 first:pl-0 last:pr-0 text-center sm:text-left">
            <p class="font-heading font-bold text-4xl md:text-5xl text-[#00f19f] mb-2">{stat}</p>
            <p class="text-gray-500 text-sm">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Related case studies ──────────────────────────────────────────────── -->
  {caseStudies.length > 0 && (
    <section class="bg-black border-t border-white/10 px-4 md:px-8 py-20">
      <div class="max-w-7xl mx-auto">
        <div class="scroll-section mb-12">
          <span class="reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm mb-4">Client work</span>
          <h2 class="reveal-line block text-4xl md:text-5xl font-heading font-bold text-white leading-none">Shopify builds.</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-8">
          {caseStudies.map((cs) => (
            <a href={`/case-studies/${cs.slug}/`} class="group block">
              <div class="aspect-video rounded-xl overflow-hidden mb-4 bg-gray-900">
                <img src={cs.image} alt={cs.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="800" height="450" />
              </div>
              <h3 class="text-xl font-heading font-bold text-white group-hover:text-[#00f19f] transition-colors">{cs.title}</h3>
              <p class="text-gray-500 text-sm mt-1">{cs.client}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Other services ────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-16">
    <div class="max-w-7xl mx-auto">
      <p class="text-gray-600 text-xs font-mono tracking-widest uppercase mb-6">Other services</p>
      <div class="flex flex-wrap gap-3">
        {siblings.map(({ label, href }) => (
          <a href={href} class="px-5 py-3 bg-gray-900/50 hover:bg-gray-800 border border-white/10 rounded-lg text-gray-300 hover:text-white text-sm transition-colors duration-200">
            {label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Accountability ───────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-16">
    <div class="max-w-7xl mx-auto flex items-start gap-6 md:gap-10">
      <img src="/images/muneer.png" alt="Muneer Zameer" class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover flex-shrink-0 grayscale" width="64" height="64" loading="lazy" />
      <div>
        <p class="text-white font-semibold mb-1.5">Muneer Zameer scopes and delivers every build.</p>
        <p class="text-gray-500 text-sm leading-relaxed max-w-2xl">There is no account manager layer. The person who quotes your build is the person who builds it. Shopify delivery in 6 weeks from final content — or the next milestone is at no charge.</p>
        <a href="/about/" class="inline-flex items-center gap-1.5 text-[#00f19f] text-xs font-mono mt-4 hover:text-white transition-colors duration-200">Meet the team →</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-white mb-6 leading-none">Ready to build your store?</h2>
      <p class="text-gray-400 text-lg mb-10 leading-relaxed">
        Send us a brief or book a 30-min call. We'll confirm whether your scope fits the fixed price or needs a custom quote before any work starts.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://cal.com/hydra-fox-sqrqbz/30min" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-8 py-4 bg-[#00f19f] hover:bg-white text-black font-bold rounded-full transition-colors text-sm">
          Book a 30-min call
        </a>
        <a href="/contact/"
           class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white hover:border-white/50 rounded-full transition-colors text-sm">
          Send a brief
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';

  function initShopifyAnimations() {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.querySelectorAll('.reveal-line').forEach((el, i) => {
          el.style.transform = 'translateY(110%)';
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        io.unobserve(entry.target);
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.scroll-section').forEach(s => io.observe(s));
  }

  document.addEventListener('astro:page-load', initShopifyAnimations);
</script>

<style>
  .reveal-line { will-change: transform; display: block; }
</style>
