---
import Layout from "../../../layouts/Layout.astro";
import {
  SERVICE_HIERARCHY,
  INDUSTRIES,
  getServiceBySlug,
} from "../../../data/taxonomy.js";
import { getCaseStudies } from "../../../data/caseStudies.js";

export function getStaticPaths() {
  return Object.keys(SERVICE_HIERARCHY).map((serviceSlug) => ({
    params: { service: serviceSlug },
  }));
}

const { service: serviceSlug } = Astro.params;
const service = getServiceBySlug(serviceSlug);

if (!service) {
  return Astro.redirect("/services/");
}

const subservices = Object.values(service.subservices) as Array<{
  name: string;
  slug: string;
  description: string;
}>;
const industries = Object.values(INDUSTRIES);
const allCaseStudies = await getCaseStudies();
const relatedCaseStudies = allCaseStudies
  .filter(
    (cs) => cs.service === serviceSlug || cs.services?.includes(serviceSlug),
  )
  .slice(0, 3);
---

<Layout
  title={`${service.name} Services | Hydra Fox Designs`}
  description={service.description}
>
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li>
          <a href="/services/" class="hover:text-white transition-colors"
            >Services</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium">{service.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-black text-white px-6 pb-20">
    <div class="max-w-7xl mx-auto">
      <span
        class="inline-block px-4 py-2 bg-green-500/10 text-green-400 rounded-full text-sm font-medium mb-6 border border-green-500/20"
      >
        {service.name} Services
      </span>
      <h1 class="text-5xl md:text-7xl font-bold mb-6">
        {service.name}
      </h1>
      <p class="text-gray-400 text-xl max-w-2xl leading-relaxed">
        {service.description}
      </p>
    </div>
  </section>

  <!-- Sub-Services -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">What We Offer</h2>
      <p class="text-gray-400 mb-12">
        Specialized services within {service.name.toLowerCase()}.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        {
          subservices.map((sub) => (
            <a
              href={`/services/${serviceSlug}/${sub.slug}/`}
              class="group block p-6 bg-gray-900/50 rounded-xl border border-gray-800 hover:border-green-500/50 transition-all"
            >
              <h3 class="text-xl font-bold mb-3 group-hover:text-green-400 transition-colors">
                {sub.name}
              </h3>
              <p class="text-gray-400 leading-relaxed">{sub.description}</p>
              <div class="mt-4 text-green-400 text-sm font-medium flex items-center gap-1">
                Learn more
                <svg
                  class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Industry Applications -->
  <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">{service.name} for Your Industry</h2>
      <p class="text-gray-400 mb-12">
        We adapt our approach based on your market's unique challenges.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          industries.map((industry) => (
            <a
              href={`/industries/${industry.slug}/`}
              class="group block p-5 bg-gray-900/30 rounded-lg border border-gray-800 hover:border-green-500/30 transition-all"
            >
              <h3 class="font-bold mb-2 group-hover:text-green-400 transition-colors">
                {industry.name}
              </h3>
              <p class="text-gray-500 text-sm line-clamp-2">
                {industry.description}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Related Case Studies -->
  {
    relatedCaseStudies.length > 0 && (
      <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl font-bold mb-4">{service.name} Case Studies</h2>
          <p class="text-gray-400 mb-12">
            See how we've applied {service.name.toLowerCase()} for real clients.
          </p>

          <div class="grid md:grid-cols-3 gap-8">
            {relatedCaseStudies.map((cs) => (
              <a href={`/work/${cs.slug}/`} class="group block">
                <div class="aspect-[4/3] rounded-xl overflow-hidden mb-4 bg-gray-900">
                  <img
                    src={cs.image}
                    alt={cs.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <h3 class="text-lg font-bold group-hover:text-green-400 transition-colors">
                  {cs.title}
                </h3>
                <p class="text-gray-400 text-sm mt-1">{cs.client}</p>
              </a>
            ))}
          </div>

          <div class="mt-12 text-center">
            <a
              href="/work/"
              class="inline-flex items-center gap-2 px-6 py-3 border border-green-500 text-green-400 hover:bg-green-500 hover:text-black font-medium rounded-full transition-all"
            >
              View All Work
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section
    class="bg-gradient-to-b from-black to-gray-900 text-white px-6 py-24 border-t border-gray-800"
  >
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">
        Ready to Transform Your {service.name}?
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        Let's discuss how our {service.name.toLowerCase()} expertise can solve your
        business challenges.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 px-10 py-4 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-colors"
      >
        Get Started
      </a>
    </div>
  </section>
</Layout>
