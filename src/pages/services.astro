---
import Navbar from '../components/Navbar';
import Splineanimation from '../components/Splineanimation';
import Layout from '../layouts/Layout.astro';
import ServiceCaseStudies from '../components/ServiceCaseStudies';
import Button from '../components/ui/Button';
import { SERVICES } from '../data/caseStudies';
import '../styles/global.css';

// Enable static pre-rendering for this page
export const prerender = true;

title: "Our Services"
---
<Layout>
  <!-- Hero Section with Background -->
  <div class="relative h-[50vh] flex items-center justify-center pt-[8vh] sm:pt-[12vh] md:pt-[20vh] w-full bg-cover bg-center bg-black -mt-12 sm:-mt-16 md:mt-0">
    <!-- Spline Animation Background -->
    <div class="absolute inset-0 z-0 h-[50vh] blur opacity-50">
      <Splineanimation client:only="react" />
    </div>
    
    <!-- Content Container -->
    <div class="relative z-10 text-center px-4">
      <h1 class="text-3xl md:text-6xl font-bold mb-6 md:mb-8 text-[#b5ffdb]">Our Services</h1>
      
      <!-- Service Tags -->
      <div class="flex flex-wrap justify-center gap-3 md:gap-4 mb-10 md:mb-12">
        {["UX/UI design", "Development", "Mobile app", "Branding", "Video editing", "Product design", "Motion design"].map(service => (
          <span class="text-white px-4 py-2 rounded-full border border-white/20 bg-white/5 text-sm hover:bg-[#00f19f] hover:text-black transition cursor-pointer">
            {service}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Services Section -->
  <section class="min-h-screen bg-black text-white px-4 md:px-16 py-12 md:py-20">
    <div class="max-w-6xl mx-auto space-y-16 md:space-y-24">
      
      <!-- Service 1: UX/UI Design -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <!-- Text Content -->
        <div class="order-2 md:order-1">
          <h2 class="text-2xl md:text-4xl font-bold text-[#b5ffdb] mb-6">UX/UI Design</h2>
          <p class="text-gray-300 mb-6 text-base md:text-lg leading-relaxed">
            We create visually stunning, user-friendly designs that enhance engagement and deliver a smooth digital experience
          </p>
          <ul class="space-y-3 text-sm md:text-base text-white">
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              User research & personas
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Competitors analysis
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Wireframes & prototypes
            </li>
          </ul>
        </div>
        
        <!-- Image -->
        <div class="order-1 md:order-2">
          <img 
            src="/images/laptop.jpg" 
            alt="UX Design Laptop" 
            class="rounded-xl w-full h-[300px] md:h-[400px] object-cover shadow-2xl hover:scale-105 transition-transform duration-300" 
            loading="lazy" 
            sizes="(max-width: 768px) 100vw, 50vw" 
          />
        </div>
      </div>

      <!-- UX/UI Case Studies -->
      <ServiceCaseStudies 
        client:only="react" 
        service={SERVICES.UX_UI_DESIGN} 
        title="UX/UI Design Case Studies"
        limit={2}
      />
      <div class="flex justify-center mt-6 mb-16">
        <Button 
          href="/case-studies?service=ux-ui-design"
          variant="outline"
          client:visible
        >
          View UX/UI Case Studies
        </Button>
      </div>

      <!-- Service 2: Development -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <!-- Image -->
        <div>
          <img 
            src="/images/desktop.png" 
            alt="Development" 
            class="rounded-xl w-full h-[300px] md:h-[400px] object-cover shadow-2xl hover:scale-105 transition-transform duration-300" 
            loading="lazy" 
            sizes="(max-width: 768px) 100vw, 50vw" 
          />
        </div>
        
        <!-- Text Content -->
        <div>
          <h2 class="text-2xl md:text-4xl font-bold text-[#b5ffdb] mb-6">Web Development</h2>
          <p class="text-gray-300 mb-6 text-base md:text-lg leading-relaxed">
            From frontend to backend, we build robust, scalable applications that perform flawlessly across all devices
          </p>
          <ul class="space-y-3 text-sm md:text-base text-white">
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Frontend development
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Backend architecture
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Database optimization
            </li>
          </ul>
        </div>
      </div>

      <!-- Web Development Case Studies -->
      <ServiceCaseStudies 
        client:only="react" 
        service={SERVICES.WEB_DEVELOPMENT} 
        title="Web Development Case Studies"
        limit={2}
      />
      <div class="flex justify-center mt-6 mb-16">
        <Button 
          href="/case-studies?service=web-development"
          variant="outline"
          client:visible
        >
          View Web Dev Case Studies
        </Button>
      </div>

      <!-- Service 3: Mobile App -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <!-- Text Content -->
        <div class="order-2 md:order-1">
          <h2 class="text-2xl md:text-4xl font-bold text-[#b5ffdb] mb-6">Mobile App</h2>
          <p class="text-gray-300 mb-6 text-base md:text-lg leading-relaxed">
            Native and cross-platform mobile applications that provide seamless user experiences on iOS and Android
          </p>
          <ul class="space-y-3 text-sm md:text-base text-white">
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              iOS & Android development
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Cross-platform solutions
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              App store optimization
            </li>
          </ul>
        </div>
        
        <!-- Image -->
        <div class="order-1 md:order-2">
          <img 
            src="/images/mobileUI.png" 
            alt="Mobile App Development" 
            class="rounded-xl w-full h-[300px] md:h-[400px] object-cover shadow-2xl hover:scale-105 transition-transform duration-300" 
            loading="lazy" 
            sizes="(max-width: 768px) 100vw, 50vw" 
          />
        </div>
      </div>

      <!-- Mobile App Case Studies -->
      <ServiceCaseStudies 
        client:only="react" 
        service={SERVICES.MOBILE_APP} 
        title="Mobile App Case Studies"
        limit={2}
      />
      <div class="flex justify-center mt-6 mb-16">
        <Button 
          href="/case-studies?service=mobile-app"
          variant="outline"
          client:visible
        >
          View Mobile App Case Studies
        </Button>
      </div>

      <!-- Service 4: Branding -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
        <!-- Image -->
        <div>
          <img 
            src="/images/mockup.png" 
            alt="Branding" 
            class="rounded-xl w-full h-[300px] md:h-[400px] object-cover shadow-2xl hover:scale-105 transition-transform duration-300" 
            loading="lazy" 
            sizes="(max-width: 768px) 100vw, 50vw" 
          />
        </div>
        
        <!-- Text Content -->
        <div>
          <h2 class="text-2xl md:text-4xl font-bold text-[#b5ffdb] mb-6">Branding</h2>
          <p class="text-gray-300 mb-6 text-base md:text-lg leading-relaxed">
            Complete brand identity solutions that capture your essence and resonate with your target audience
          </p>
          <ul class="space-y-3 text-sm md:text-base text-white">
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Logo & visual identity
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Brand guidelines
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Marketing materials
            </li>
          </ul>
        </div>
      </div>

      <!-- Branding Case Studies -->
      <ServiceCaseStudies 
        client:only="react" 
        service={SERVICES.BRANDING} 
        title="Branding Case Studies"
        limit={2}
      />
      <div class="flex justify-center mt-6 mb-16">
        <Button 
          href="/case-studies?service=branding"
          variant="outline"
          client:visible
        >
          View Branding Case Studies
        </Button>
      </div>

      <!-- Service 5: Digital Marketing -->
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      
        <!-- Text Content -->
        <div>
          <h2 class="text-2xl md:text-4xl font-bold text-[#b5ffdb] mb-6">Digital Marketing</h2>
          <p class="text-gray-300 mb-6 text-base md:text-lg leading-relaxed">
            Helping you reach and engage your audience through targeted strategies and compelling content
          </p>
          <ul class="space-y-3 text-sm md:text-base text-white">
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Social media management
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              SEO optimization
            </li>
            <li class="flex items-center gap-3">
              <span class="text-green-400 text-lg">●</span> 
              Content creation
            </li>
          </ul>
        </div>
         <!-- Image -->
        <div>
          <img 
            src="/images/ads.png" 
            alt="Digital Marketing" 
            class="rounded-xl w-full h-[300px] md:h-[400px] object-cover shadow-2xl hover:scale-105 transition-transform duration-300" 
            loading="lazy" 
            sizes="(max-width: 768px) 100vw, 50vw" 
          />
        </div>
        
      </div>

      <!-- Digital Marketing Case Studies -->
      <ServiceCaseStudies 
        client:only="react" 
        service={SERVICES.DIGITAL_MARKETING} 
        title="Digital Marketing Case Studies"
        limit={2}
      />
      <div class="flex justify-center mt-6 mb-16">
        <Button 
          href="/case-studies?service=digital-marketing"
          variant="outline"
          client:visible
        >
          View Marketing Case Studies
        </Button>
      </div>

    </div>
  </section>
</Layout>