---
import Layout from "../../layouts/Layout.astro";
import { getCaseStudies } from "../../data/caseStudies";
import CaseStudyListing from "../../components/CaseStudyListing";

const caseStudies: any[] = await getCaseStudies();
---

<Layout
  title="Case Studies | Hydra Fox Designs"
  description="Explore our portfolio of successful projects. See how we've helped clients solve challenges and achieve their goals."
>
  <!-- Hero Section -->
  <div
    class="relative h-[60vh] flex flex-col items-center justify-center w-full bg-black overflow-hidden -mt-16 md:mt-0"
  >
    <div
      class="absolute inset-0 bg-gradient-to-b from-green-900/10 to-transparent pointer-events-none z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-[url('/images/noise.png')] opacity-20 pointer-events-none z-0"
    >
    </div>

    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
      <span
        class="text-green-500 font-bold tracking-[0.2em] uppercase text-sm mb-4 block animate-fade-in-up"
      >
        Our Work
      </span>
      <h1
        class="text-5xl md:text-8xl font-bold text-white mb-6 leading-tight tracking-tight"
      >
        Building <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600"
          >Trust</span
        >
        <br />
        Through Results.
      </h1>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto font-light">
        We don't just showcase designs. We demonstrate the tangible impact we've
        created for lifestyle brands.
      </p>
    </div>
  </div>

  <!-- Interactive Listing -->
  <CaseStudyListing client:load initialCaseStudies={caseStudies as any} />
</Layout>
