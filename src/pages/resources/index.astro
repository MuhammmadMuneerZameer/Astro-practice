---
import Layout from '../../layouts/Layout.astro';
import { getAllResourceCategories } from '../../data/taxonomy.js';
import OptimizedBlogList from '../../components/OptimizedBlogList.tsx';

const categories = getAllResourceCategories();
---

<Layout
  title="Resources | Hydra Fox Designs"
  description="Insights on branding, design, marketing, and web development to help your business grow."
>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="res-hero relative min-h-[50vh] flex flex-col justify-end pb-16 px-4 md:px-8 bg-black overflow-hidden -mt-16 md:mt-0 pt-32 md:pt-40">
    <div class="relative z-10 max-w-7xl mx-auto w-full">
      <div class="overflow-hidden mb-4">
        <span class="res-reveal-line block text-[#00f19f] font-bold tracking-[0.2em] uppercase text-xs sm:text-sm">
          Knowledge Base
        </span>
      </div>
      <h1 class="font-heading font-bold leading-none tracking-tight mb-8">
        <div class="overflow-hidden">
          <span class="res-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            Resources
          </span>
        </div>
        <div class="overflow-hidden">
          <span class="res-reveal-line block text-5xl sm:text-7xl md:text-8xl lg:text-[9rem] text-white">
            & Insights.
          </span>
        </div>
      </h1>
      <div class="overflow-hidden max-w-xl">
        <p class="res-reveal-fade text-gray-400 text-base md:text-lg font-light leading-relaxed">
          Practical insights on branding, design, marketing, and web development.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Category Navigation ───────────────────────────────────────────────── -->
  <section transition:name="resources-category-nav" transition:animate="none" class="bg-black border-t border-white/10 px-4 md:px-8 py-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center h-9 px-4 bg-[#00f19f] text-black rounded-full text-sm font-bold">
          All Resources
        </span>
        {categories.map(cat => (
          <a
            href={`/resources/${cat.slug}/`}
            class="inline-flex items-center h-9 px-4 border border-white/20 hover:border-white/50 text-gray-400 hover:text-white rounded-full text-sm transition-colors duration-200"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Audit lead magnet ────────────────────────────────────────────────── -->
  <section class="bg-black border-t border-white/10 px-4 md:px-8 py-10">
    <div class="max-w-7xl mx-auto">
      <a href="/audit/" class="group block border border-[#00f19f]/20 hover:border-[#00f19f]/50 rounded-2xl p-8 md:p-10 bg-[#00f19f]/3 transition-colors duration-300">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <p class="text-[#00f19f] text-xs font-mono tracking-widest uppercase mb-3">Free · 48-hour turnaround</p>
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-white mb-3 group-hover:text-[#00f19f] transition-colors duration-300">
              Free Ecommerce Growth Audit
            </h2>
            <ul class="flex flex-col sm:flex-row gap-3 sm:gap-6 text-sm text-gray-400">
              <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-[#00f19f]" />Store speed and CVR review</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-[#00f19f]" />Ad account and attribution audit</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-[#00f19f]" />Klaviyo flow coverage check</li>
            </ul>
          </div>
          <span class="inline-flex items-center gap-2 text-[#00f19f] text-sm font-medium group-hover:text-white transition-colors duration-300 flex-shrink-0">
            Request free audit
            <svg class="w-4 h-4 -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ── Posts ─────────────────────────────────────────────────────────────── -->
  <section class="bg-black px-4 md:px-8 pt-4 pb-24">
    <div class="max-w-7xl mx-auto">
      <OptimizedBlogList client:only="react" />
    </div>
  </section>

</Layout>

<script>
  const EXPO_OUT = 'cubic-bezier(0.19, 1, 0.22, 1)';
  const CUBIC_OUT = 'cubic-bezier(0.215, 0.61, 0.355, 1)';

  function initResAnimations() {
    const lines = document.querySelectorAll('.res-reveal-line');
    const fades = document.querySelectorAll('.res-reveal-fade');

    lines.forEach(el => { el.style.transform = 'translateY(110%)'; });
    fades.forEach(el => { el.style.opacity = '0'; });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        lines.forEach((el, i) => {
          const anim = el.animate(
            [{ transform: 'translateY(110%)' }, { transform: 'translateY(0)' }],
            { duration: 900, delay: i * 130, easing: EXPO_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
        fades.forEach((el, i) => {
          const anim = el.animate(
            [{ opacity: '0' }, { opacity: '1' }],
            { duration: 700, delay: 400 + i * 100, easing: CUBIC_OUT, fill: 'forwards' }
          );
          anim.onfinish = () => { el.style.willChange = 'auto'; };
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initResAnimations);
</script>

<style>
  .res-reveal-line { will-change: transform; }
  .res-reveal-fade { will-change: opacity; }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }
</style>
