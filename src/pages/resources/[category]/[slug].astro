---
import Layout from "../../../layouts/Layout.astro";
import { getPosts } from "../../../data/blogPost.js";
import {
  getResourceCategoryBySlug,
  SERVICE_HIERARCHY,
} from "../../../data/taxonomy.js";
import { categoryToSlug } from "../../../lib/utils.js";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: {
      category: categoryToSlug(post.category),
      slug: post.slug,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { category } = Astro.params;

if (!post) {
  return Astro.redirect("/resources/");
}

// Convert plain-text content (old posts) to HTML.
// New posts already store HTML from the admin converter.
function processContent(content: string): string {
  if (!content) return '';
  const trimmed = content.trim();
  if (trimmed.startsWith('<')) return content; // already HTML

  // Plain text fallback: convert line-by-line to paragraphs/headings/images
  const escHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  const safeUrl = (url: string) =>
    /^(https?:|mailto:|\/|#)/.test(url) ? url : '#';

  const inline = (s: string) =>
    s
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/\[(.+?)\]\((.+?)\)/g, (_, text, url) => `<a href="${safeUrl(url)}" target="_blank" rel="noopener noreferrer">${text}</a>`);

  const lines = trimmed.split('\n');
  let html = '';
  let inUl = false, inOl = false;
  const paraLines: string[] = [];

  const flushPara = () => {
    if (paraLines.length === 0) return;
    html += `<p>${inline(paraLines.join(' '))}</p>\n`;
    paraLines.length = 0;
  };
  const closeList = () => {
    if (inUl) { html += '</ul>\n'; inUl = false; }
    if (inOl) { html += '</ol>\n'; inOl = false; }
  };

  for (const line of lines) {
    const t = line.trim();
    if (!t) { flushPara(); closeList(); continue; }
    if (t.match(/^https?:\/\/.+\.(jpg|jpeg|png|gif|webp|svg)(\?.*)?$/i)) {
      flushPara(); closeList();
      html += `<figure class="w-full my-8 clear-both"><img src="${safeUrl(t)}" alt="" class="w-full h-auto rounded-xl" /></figure>\n`;
      continue;
    }
    const imgM = t.match(/^!\[(.*?)\]\((.+?)\)$/);
    if (imgM) {
      flushPara(); closeList();
      html += `<figure class="w-full my-8 clear-both"><img src="${safeUrl(imgM[2])}" alt="${escHtml(imgM[1])}" class="w-full h-auto rounded-xl" /></figure>\n`;
      continue;
    }
    if (t.startsWith('### ')) { flushPara(); closeList(); html += `<h4>${inline(t.slice(4))}</h4>\n`; continue; }
    if (t.startsWith('## '))  { flushPara(); closeList(); html += `<h3>${inline(t.slice(3))}</h3>\n`; continue; }
    if (t.startsWith('# '))   { flushPara(); closeList(); html += `<h2>${inline(t.slice(2))}</h2>\n`; continue; }
    if (t === '---')           { flushPara(); closeList(); html += '<hr />\n'; continue; }
    if (t.startsWith('> '))    { flushPara(); closeList(); html += `<blockquote>${inline(t.slice(2))}</blockquote>\n`; continue; }
    if (t.startsWith('- ') || t.startsWith('* ')) {
      flushPara();
      if (inOl) { html += '</ol>\n'; inOl = false; }
      if (!inUl) { html += '<ul>\n'; inUl = true; }
      html += `<li>${inline(t.slice(2))}</li>\n`; continue;
    }
    if (t.match(/^\d+\.\s/)) {
      flushPara();
      if (inUl) { html += '</ul>\n'; inUl = false; }
      if (!inOl) { html += '<ol>\n'; inOl = true; }
      html += `<li>${inline(t.replace(/^\d+\.\s/, ''))}</li>\n`; continue;
    }
    closeList();
    paraLines.push(t);
  }
  flushPara(); closeList();
  return html;
}

const renderedContent = processContent(post.content || '');

const categoryInfo = getResourceCategoryBySlug(category);

// Map blog category slugs (old and new) to SERVICE_HIERARCHY keys
const CATEGORY_TO_SERVICE_SLUG: Record<string, string> = {
  // New slugs — direct match
  'ecommerce-growth':        'ecommerce-growth',
  'store-design-build':      'store-design-build',
  'growth-tools-automation': 'growth-tools-automation',
  'brand-content':           'brand-content',
  // Old taxonomy slugs
  'marketing':               'ecommerce-growth',
  'growth-engineering':      'ecommerce-growth',
  'conversion-engineering':  'ecommerce-growth',
  'branding':                'brand-content',
  'design':                  'store-design-build',
  'web':                     'store-design-build',
  'video-production':        'brand-content',
};
const serviceSlug = CATEGORY_TO_SERVICE_SLUG[category];
const relatedService = serviceSlug ? (SERVICE_HIERARCHY as Record<string, any>)[serviceSlug] : null;

// Get related posts (same category, different post)
const allPosts = await getPosts();
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.slug !== post.slug &&
      p.category === category &&
      p.status === "published",
  )
  .slice(0, 3);

// More posts from other categories (fill up to 6 excluding current + related)
const relatedSlugs = new Set([post.slug, ...relatedPosts.map(p => p.slug)]);
const morePosts = allPosts
  .filter((p) => p.status === "published" && !relatedSlugs.has(p.slug))
  .slice(0, 6);
---

<Layout
  title={`${post.title || post.slug?.replace(/-/g, ' ') || 'Resource'} | Hydra Fox Designs`}
  description={post.description || `Read this resource from Hydra Fox Designs.`}
  image={post.image}
>
  <!-- Article JSON-LD -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.title,
      description: post.description,
      image: post.image ? new URL(post.image, Astro.site).href : undefined,
      datePublished: post.date || undefined,
      author: {
        "@type": "Person",
        name: "Muneer Zameer",
        url: "https://hydrafoxdesigns.com/about/",
      },
      publisher: {
        "@type": "Organization",
        name: "Hydra Fox Designs",
        logo: {
          "@type": "ImageObject",
          url: "https://hydrafoxdesigns.com/images/hfd-logo.png",
        },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": new URL(Astro.url.pathname, Astro.site).href,
      },
    })}
  />
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400 flex-wrap">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li>
          <a href="/resources/" class="hover:text-white transition-colors"
            >Resources</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li>
          <a
            href={`/resources/${category}/`}
            class="hover:text-white transition-colors capitalize"
            >{categoryInfo?.name || category}</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium truncate max-w-[200px]">
          {post.title}
        </li>
      </ol>
    </div>
  </nav>

  <article class="bg-black text-white">
    <!-- Article Header -->
    <header class="px-6 pb-12">
      <div class="max-w-3xl mx-auto">
        {
          category && (
            <a
              href={`/resources/${category}/`}
              class="inline-block px-4 py-2 bg-green-500/10 text-green-400 rounded-full text-sm font-medium mb-6 border border-green-500/20 hover:bg-green-500/20 transition-colors capitalize"
            >
              {categoryInfo?.name || category}
            </a>
          )
        }
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          {post.title}
        </h1>
        <p class="text-gray-400 text-xl leading-relaxed">
          {post.description}
        </p>
        <div class="flex items-center gap-3 mt-6">
          <img
            src="/images/muneer.png"
            alt="Muneer Zameer"
            class="w-10 h-10 rounded-full object-cover flex-shrink-0"
            width="40"
            height="40"
            loading="lazy"
          />
          <div>
            <p class="text-white text-sm font-medium">Muneer Zameer</p>
            <p class="text-gray-500 text-xs">
              Founder &amp; CEO · DTC operator, Pakistan National Store
              {post.date && (
                <span class="ml-2 text-gray-600">·&nbsp;{new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
              )}
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    {
      post.image && (
        <div class="px-6 pb-12">
          <div class="max-w-4xl mx-auto">
            <div class="aspect-video rounded-2xl overflow-hidden bg-gray-900">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover"
                width="1200"
                height="675"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      )
    }

    <!-- Article Content -->
    <div class="px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <div
          class="prose prose-lg prose-invert prose-green max-w-none"
          set:html={renderedContent}
        />
      </div>
    </div>

    <!-- Tags -->
    {
      post.tag && (
        <div class="px-6 pb-12 border-t border-gray-800 pt-12">
          <div class="max-w-3xl mx-auto">
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-500 text-sm">Tags:</span>
              <span class="px-3 py-1 bg-gray-900 text-gray-400 rounded-full text-sm">
                {post.tag}
              </span>
            </div>
          </div>
        </div>
      )
    }


    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="px-6 py-16 border-t border-gray-800">
          <div class="max-w-7xl mx-auto">
            <h2 class="text-2xl font-bold mb-8">Related Articles</h2>
            <div class="grid md:grid-cols-3 gap-8">
              {relatedPosts.map((related) => (
                <a
                  href={`/resources/${related.category || "general"}/${related.slug}/`}
                  class="group block"
                >
                  <div class="aspect-[16/10] rounded-xl overflow-hidden mb-4 bg-gray-900">
                    <img
                      src={related.image}
                      alt={related.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width="800"
                      height="500"
                      loading="lazy"
                    />
                  </div>
                  <h3 class="text-lg font-bold group-hover:text-green-400 transition-colors line-clamp-2">
                    {related.title}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

  </article>

  <!-- More from our blog -->
  {
    morePosts.length > 0 && (
      <section class="bg-black text-white px-6 py-20 border-t border-gray-800">
        <div class="max-w-7xl mx-auto">
          <div class="flex items-center justify-between mb-10">
            <h2 class="text-2xl md:text-3xl font-bold">
              More from our <span class="text-green-400">blog</span>
            </h2>
            <a
              href="/resources/"
              class="inline-flex items-center gap-1.5 border border-green-500/50 text-green-400 px-4 py-1.5 rounded-full text-sm hover:bg-green-500 hover:text-black transition-colors"
            >
              View all
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {morePosts.map((p) => (
              <a
                href={`/resources/${categoryToSlug(p.category)}/${p.slug}/`}
                class="group block"
              >
                <div class="bg-gray-900 border border-gray-800 group-hover:border-green-500/50 rounded-xl overflow-hidden transition-all h-full flex flex-col">
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={p.image}
                      alt={p.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      width="800"
                      height="500"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-4 flex flex-col flex-grow">
                    {p.category && (
                      <span class="text-green-400 text-xs font-medium mb-2 capitalize">
                        {p.category}
                      </span>
                    )}
                    <h3 class="text-white font-semibold leading-snug mb-2 group-hover:text-green-400 transition-colors line-clamp-2">
                      {p.title}
                    </h3>
                    <p class="text-gray-400 text-sm line-clamp-2 mt-auto">
                      {p.description}
                    </p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Closing block -->
  <section class="bg-black border-t border-white/10 px-6 py-20">
    <div class="max-w-3xl mx-auto space-y-6">

      <!-- Relevant service card -->
      {relatedService && (
        <div class="p-6 bg-white/[0.03] rounded-xl border border-white/10">
          <p class="text-[#00f19f] text-xs font-bold tracking-[0.2em] uppercase mb-3">{relatedService.name}</p>
          <p class="text-white font-semibold text-base mb-2 leading-snug">{relatedService.description}</p>
          <a
            href={`/services/${relatedService.slug}/`}
            class="inline-flex items-center gap-1.5 text-[#00f19f] text-sm font-medium hover:text-white transition-colors duration-300 mt-1"
          >
            See how we do it
            <svg class="w-3.5 h-3.5 -rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      )}

      <!-- Case study card -->
      <div class="p-6 bg-white/[0.03] rounded-xl border border-white/10">
        <p class="text-[#00f19f] text-xs font-bold tracking-[0.2em] uppercase mb-3">Case Study</p>
        <p class="text-white font-semibold text-base mb-2 leading-snug">See what this looks like with a real DTC brand and real numbers.</p>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">
          We worked with Ahd e Qadeem on Shopify store build, paid media, and Klaviyo retention. The case study breaks down the specific changes we made and the metrics they moved.
        </p>
        <a
          href="/case-studies/pakistan-national-store/"
          class="inline-flex items-center gap-1.5 text-[#00f19f] text-sm font-medium hover:text-white transition-colors duration-300"
        >
          Read the full case study
          <svg class="w-3.5 h-3.5 -rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Free audit CTA -->
      <div class="p-6 rounded-xl border border-[#00f19f]/20 bg-[#00f19f]/5">
        <p class="text-[#00f19f] text-xs font-bold tracking-[0.2em] uppercase mb-3">Free Audit</p>
        <p class="text-white font-semibold text-base mb-2 leading-snug">Find out what's costing you contribution margin.</p>
        <p class="text-gray-400 text-sm leading-relaxed mb-5">
          We'll review your Shopify store, ad account structure, email flows, and attribution setup — then send you the three biggest gaps within 48 hours. No sales call required.
        </p>
        <a
          href="/#audit"
          class="inline-flex items-center gap-1.5 text-black bg-[#00f19f] hover:bg-white px-5 py-2.5 rounded-full text-sm font-bold transition-colors duration-300"
        >
          Request my free audit
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Blog content clearfix for floated images */
  .blog-content::after {
    content: "";
    display: table;
    clear: both;
  }

  /* Ensure paragraphs clear after floated images when needed */
  .blog-content > p {
    overflow: hidden;
  }

  /* Smooth transitions for links */
  .blog-content a {
    transition: color 0.2s ease;
  }

  /* Better code block styling */
  .blog-content pre {
    @apply bg-gray-900 p-4 rounded-lg overflow-x-auto my-6;
  }

  /* Image hover effect */
  .blog-content figure img {
    @apply transition-transform duration-300;
  }
  .blog-content figure:hover img {
    @apply scale-[1.02];
  }

  /* Legacy prose styles (for backwards compatibility) */
  .prose h2 {
    @apply text-2xl font-bold mt-12 mb-4 text-white;
  }
  .prose h3 {
    @apply text-xl font-bold mt-8 mb-3 text-white;
  }
  .prose p {
    @apply text-gray-300 mb-6 leading-relaxed;
  }
  .prose ul,
  .prose ol {
    @apply my-6 pl-6 text-gray-300;
  }
  .prose li {
    @apply mb-2;
  }
  .prose a {
    @apply text-green-400 hover:text-green-300 underline;
  }
  .prose blockquote {
    @apply border-l-4 border-green-500 pl-6 my-8 italic text-gray-400;
  }
  .prose code {
    @apply bg-gray-900 px-2 py-1 rounded text-green-400 text-sm;
  }
  .prose pre {
    @apply bg-gray-900 p-4 rounded-lg overflow-x-auto my-6;
  }
  .prose img {
    @apply rounded-xl my-8;
  }
</style>
