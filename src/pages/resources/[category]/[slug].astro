---
import Layout from "../../../layouts/Layout.astro";
import { getPosts } from "../../../data/blogPost.js";
import {
  getResourceCategoryBySlug,
  SERVICE_HIERARCHY,
} from "../../../data/taxonomy.js";
import { categoryToSlug } from "../../../lib/utils.js";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: {
      category: categoryToSlug(post.category),
      slug: post.slug,
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { category } = Astro.params;

if (!post) {
  return Astro.redirect("/resources/");
}

const categoryInfo = getResourceCategoryBySlug(category);
const relatedService = (SERVICE_HIERARCHY as Record<string, any>)[category];

// Get related posts (same category, different post)
const allPosts = await getPosts();
const relatedPosts = allPosts
  .filter(
    (p) =>
      p.slug !== post.slug &&
      p.category === category &&
      p.status === "published",
  )
  .slice(0, 3);
---

<Layout
  title={`${post.title} | Hydra Fox Designs`}
  description={post.description}
  image={post.image}
>
  <!-- Article JSON-LD -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: post.title,
      description: post.description,
      image: post.image ? new URL(post.image, Astro.site).href : undefined,
      datePublished: post.date || undefined,
      author: {
        "@type": "Organization",
        name: "Hydra Fox Designs",
        url: "https://hydrafoxdesigns.com",
      },
      publisher: {
        "@type": "Organization",
        name: "Hydra Fox Designs",
        logo: {
          "@type": "ImageObject",
          url: "https://hydrafoxdesigns.com/images/hfd-logo.png",
        },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": new URL(Astro.url.pathname, Astro.site).href,
      },
    })}
  />
  <!-- Breadcrumb -->
  <nav class="bg-black pt-24 pb-4 px-6">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-gray-400 flex-wrap">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li class="text-gray-600">/</li>
        <li>
          <a href="/resources/" class="hover:text-white transition-colors"
            >Resources</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li>
          <a
            href={`/resources/${category}/`}
            class="hover:text-white transition-colors capitalize"
            >{categoryInfo?.name || category}</a
          >
        </li>
        <li class="text-gray-600">/</li>
        <li class="text-white font-medium truncate max-w-[200px]">
          {post.title}
        </li>
      </ol>
    </div>
  </nav>

  <article class="bg-black text-white">
    <!-- Article Header -->
    <header class="px-6 pb-12">
      <div class="max-w-3xl mx-auto">
        {
          category && (
            <a
              href={`/resources/${category}/`}
              class="inline-block px-4 py-2 bg-green-500/10 text-green-400 rounded-full text-sm font-medium mb-6 border border-green-500/20 hover:bg-green-500/20 transition-colors capitalize"
            >
              {categoryInfo?.name || category}
            </a>
          )
        }
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          {post.title}
        </h1>
        <p class="text-gray-400 text-xl leading-relaxed">
          {post.description}
        </p>
        {
          post.date && (
            <p class="text-gray-500 text-sm mt-6">
              {new Date(post.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
          )
        }
      </div>
    </header>

    <!-- Featured Image -->
    {
      post.image && (
        <div class="px-6 pb-12">
          <div class="max-w-4xl mx-auto">
            <div class="aspect-video rounded-2xl overflow-hidden bg-gray-900">
              <img
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      )
    }

    <!-- Article Content -->
    <div class="px-6 pb-20">
      <div class="max-w-3xl mx-auto">
        <div
          class="prose prose-lg prose-invert prose-green max-w-none"
          set:html={post.content}
        />
      </div>
    </div>

    <!-- Tags -->
    {
      post.tag && (
        <div class="px-6 pb-12 border-t border-gray-800 pt-12">
          <div class="max-w-3xl mx-auto">
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-500 text-sm">Tags:</span>
              <span class="px-3 py-1 bg-gray-900 text-gray-400 rounded-full text-sm">
                {post.tag}
              </span>
            </div>
          </div>
        </div>
      )
    }

    <!-- Related Service -->
    {
      relatedService && (
        <div class="px-6 pb-12 border-t border-gray-800 pt-12">
          <div class="max-w-3xl mx-auto">
            <div class="p-6 bg-gray-900/50 rounded-xl border border-gray-800">
              <h3 class="text-xl font-bold mb-2">
                Need Help With {relatedService.name}?
              </h3>
              <p class="text-gray-400 mb-4">{relatedService.description}</p>
              <a
                href={`/services/${relatedService.slug}/`}
                class="inline-flex items-center gap-2 text-green-400 font-medium hover:text-green-300"
              >
                Explore {relatedService.name} Services
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      )
    }

    <!-- Related Articles -->
    {
      relatedPosts.length > 0 && (
        <section class="px-6 py-16 border-t border-gray-800">
          <div class="max-w-7xl mx-auto">
            <h2 class="text-2xl font-bold mb-8">Related Articles</h2>
            <div class="grid md:grid-cols-3 gap-8">
              {relatedPosts.map((related) => (
                <a
                  href={`/resources/${related.category || "general"}/${related.slug}/`}
                  class="group block"
                >
                  <div class="aspect-[16/10] rounded-xl overflow-hidden mb-4 bg-gray-900">
                    <img
                      src={related.image}
                      alt={related.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <h3 class="text-lg font-bold group-hover:text-green-400 transition-colors line-clamp-2">
                    {related.title}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Back Links -->
    <section class="px-6 py-12 border-t border-gray-800">
      <div
        class="max-w-7xl mx-auto flex flex-wrap gap-6 justify-center text-sm"
      >
        <a
          href={`/resources/${category}/`}
          class="text-green-400 hover:text-green-300 capitalize"
        >
          ← More {categoryInfo?.name || category} Articles
        </a>
        <a href="/resources/" class="text-green-400 hover:text-green-300">
          All Resources
        </a>
      </div>
    </section>
  </article>

  <!-- CTA -->
  <section
    class="bg-gradient-to-b from-black to-gray-900 text-white px-6 py-24 border-t border-gray-800"
  >
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Put This Into Practice?</h2>
      <p class="text-gray-400 text-lg mb-10">
        Let's discuss how we can help you implement these strategies.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 px-10 py-4 bg-green-500 hover:bg-green-600 text-black font-bold rounded-full transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>

<style>
  /* Blog content clearfix for floated images */
  .blog-content::after {
    content: "";
    display: table;
    clear: both;
  }

  /* Ensure paragraphs clear after floated images when needed */
  .blog-content > p {
    overflow: hidden;
  }

  /* Smooth transitions for links */
  .blog-content a {
    transition: color 0.2s ease;
  }

  /* Better code block styling */
  .blog-content pre {
    @apply bg-gray-900 p-4 rounded-lg overflow-x-auto my-6;
  }

  /* Image hover effect */
  .blog-content figure img {
    @apply transition-transform duration-300;
  }
  .blog-content figure:hover img {
    @apply scale-[1.02];
  }

  /* Legacy prose styles (for backwards compatibility) */
  .prose h2 {
    @apply text-2xl font-bold mt-12 mb-4 text-white;
  }
  .prose h3 {
    @apply text-xl font-bold mt-8 mb-3 text-white;
  }
  .prose p {
    @apply text-gray-300 mb-6 leading-relaxed;
  }
  .prose ul,
  .prose ol {
    @apply my-6 pl-6 text-gray-300;
  }
  .prose li {
    @apply mb-2;
  }
  .prose a {
    @apply text-green-400 hover:text-green-300 underline;
  }
  .prose blockquote {
    @apply border-l-4 border-green-500 pl-6 my-8 italic text-gray-400;
  }
  .prose code {
    @apply bg-gray-900 px-2 py-1 rounded text-green-400 text-sm;
  }
  .prose pre {
    @apply bg-gray-900 p-4 rounded-lg overflow-x-auto my-6;
  }
  .prose img {
    @apply rounded-xl my-8;
  }
</style>
