---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const products = [
  {
    title: 'Dior BACKSTAGE Glow Face Palette',
    vendor: 'Dior',
    price: 'Rs. 15,500',
    tag: 'Glow Palette',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/DiorBACKSTAGEGlowFacePalette.webp?v=1716788262',
  },
  {
    title: 'Charlotte Tilbury Airbrush Foundation',
    vendor: 'Charlotte Tilbury',
    price: 'Rs. 14,000',
    tag: 'Longwear',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/2_Cool_-_for_fair_skin_with_cool_undertones.webp?v=1715555750',
  },
  {
    title: 'NARS Natural Radiant Longwear',
    vendor: 'NARS',
    price: 'Rs. 17,000',
    tag: 'Radiant Finish',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/s2204717-main-zoom.webp?v=1727935208',
  },
  {
    title: 'e.l.f. Halo Glow Liquid Filter',
    vendor: 'e.l.f.',
    price: 'Rs. 5,500',
    tag: 'Liquid Glow',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/82113_OpenA_R-555x555.jpg?v=1714708394',
  },
  {
    title: 'Maybelline Fit Me Loose Powder',
    vendor: 'Maybelline',
    price: 'Rs. 3,800',
    tag: 'Finishing',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/FITMEPOWER.jpg?v=1714630134',
  },
  {
    title: 'Milani Make It Last Setting Spray',
    vendor: 'Milani',
    price: 'Rs. 4,000',
    tag: 'Setting Spray',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/1_MakeItLast_SettingSpray_03_PDP_PoductWithSwatch_Seal_2_grande_77faf687-4a7e-4e86-a207-f4bd6f5f3f26.webp?v=1716928332',
  },
  {
    title: 'Maybelline Serum Lipstick Matte',
    vendor: 'Maybelline',
    price: 'Rs. 4,000',
    tag: 'Matte Lip',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/Crop_Top_001.avif?v=1772092827',
  },
  {
    title: 'ELF Power Grip Primer',
    vendor: 'e.l.f.',
    price: 'Rs. 4,000',
    tag: 'Primer',
    image: 'https://arooshcosmetics.pk/cdn/shop/files/gel.jpg?v=1711392020',
  },
];

const categories = [
  {
    title: 'Imported Beauty',
    copy: 'Curated premium makeup, skincare, and daily glow essentials.',
    image: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=1200&q=80',
  },
  {
    title: 'Editorial Wardrobe',
    copy: 'Clean silhouettes, winter layers, and quiet luxury styling.',
    image: 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1200&q=80',
  },
  {
    title: 'The Gift Edit',
    copy: 'Ready-to-ship pieces for birthdays, events, and last minute plans.',
    image: 'https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=1200&q=80',
  },
];
---

<Layout
  title="Aroosh Cosmetics | Premium Beauty Store"
  description="Shop imported premium makeup, skincare, and beauty essentials in Pakistan with Cash on Delivery available."
  image={products[0].image}
  hideChrome
>
  <section class="storefront">
    <header class="store-header">
      <a class="brand" href="/" aria-label="Aroosh Cosmetics home">
        <span class="brand-mark">A</span>
        <span>Aroosh</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#shop">Shop</a>
        <a href="#edits">Edits</a>
        <a href="#brands">Brands</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="cart-link" href="#shop" aria-label="Open bag">
        <span>Bag</span>
        <strong>0</strong>
      </a>
    </header>

    <div class="announcement" aria-label="Store announcements">
      <span>Free delivery over Rs. 5,000</span>
      <span>New arrivals weekly</span>
      <span>Cash on delivery available</span>
      <span>Authentic products guaranteed</span>
    </div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Premium beauty in Pakistan</p>
        <h1 id="hero-title">Imported makeup, skincare, and glow essentials.</h1>
        <p>
          A refined ecommerce storefront inspired by the supplied Aroosh,
          clothing, and Essence references, rebuilt inside the existing Astro site.
        </p>
        <div class="hero-actions">
          <a class="primary-button" href="#shop">Shop the edit</a>
          <a class="secondary-button" href="#edits">View collections</a>
        </div>
      </div>
      <div class="hero-media" aria-label="Featured beauty collection">
        <img
          src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1400&q=85"
          alt="Premium cosmetics arranged on a studio table"
          loading="eager"
        />
        <div class="hero-note">
          <span>New drop</span>
          <strong>Glow Edit 2026</strong>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Store benefits">
      <div>
        <strong>COD</strong>
        <span>Pay when your parcel arrives.</span>
      </div>
      <div>
        <strong>100%</strong>
        <span>Authentic sourced products.</span>
      </div>
      <div>
        <strong>48h</strong>
        <span>Fast dispatch in major cities.</span>
      </div>
    </section>

    <section id="edits" class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Curated collections</p>
        <h2>Shop by mood</h2>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <article class="category-card">
            <img src={category.image} alt={`${category.title} collection`} loading="lazy" />
            <div>
              <h3>{category.title}</h3>
              <p>{category.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="shop" class="section-block product-section">
      <div class="section-heading wide">
        <div>
          <p class="eyebrow">Featured products</p>
          <h2>Shop the edit</h2>
        </div>
        <a href="#contact">Need help choosing?</a>
      </div>
      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image">
              <img src={product.image} alt={product.title} loading="lazy" />
              <span>{product.tag}</span>
            </div>
            <div class="product-info">
              <p>{product.vendor}</p>
              <h3>{product.title}</h3>
              <div>
                <strong>{product.price}</strong>
                <button type="button" aria-label={`Add ${product.title} to bag`}>Add</button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="editorial">
      <img
        src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=1400&q=85"
        alt="Editorial fashion and beauty campaign"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Winter archive</p>
        <h2>Luxury must feel effortless.</h2>
        <p>
          Editorial product pages, clean product cards, refined typography, and
          high-contrast commerce controls brought together in one homepage.
        </p>
        <a class="secondary-button light" href="#shop">Explore now</a>
      </div>
    </section>

    <section id="brands" class="brand-wall" aria-label="Brands we carry">
      <p class="eyebrow">Brands we carry</p>
      <div>
        <span>Dior</span>
        <span>Charlotte Tilbury</span>
        <span>NARS</span>
        <span>Rare Beauty</span>
        <span>e.l.f.</span>
        <span>Maybelline</span>
      </div>
    </section>

    <footer id="contact" class="store-footer">
      <div>
        <a class="brand" href="/" aria-label="Aroosh Cosmetics home">
          <span class="brand-mark">A</span>
          <span>Aroosh</span>
        </a>
        <p>Premium imported beauty, shipped across Pakistan.</p>
      </div>
      <div>
        <a href="mailto:hello@arooshcosmetics.pk">hello@arooshcosmetics.pk</a>
        <a href="tel:+923354345625">+92 335 4345625</a>
      </div>
    </footer>
  </section>
</Layout>

<style>
  :global(html),
  :global(body) {
    background: #f6f0e7 !important;
  }

  :global(main) {
    background: #f6f0e7 !important;
  }

  .storefront {
    min-height: 100vh;
    background: #f6f0e7;
    color: #171310;
    font-family: Inter, system-ui, sans-serif;
  }

  .store-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 18px clamp(18px, 4vw, 56px);
    border-bottom: 1px solid rgba(23, 19, 16, 0.12);
    background: rgba(246, 240, 231, 0.9);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 13px;
    font-weight: 800;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: Georgia, serif;
    font-size: 18px;
    letter-spacing: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  nav a,
  .cart-link,
  .store-footer a {
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 700;
  }

  .cart-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .cart-link strong {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: #171310;
    color: #f6f0e7;
  }

  .announcement {
    display: flex;
    gap: 34px;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 1px solid rgba(23, 19, 16, 0.12);
    background: #c6dc75;
    padding: 10px 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 11px;
    font-weight: 800;
  }

  .announcement span {
    animation: drift 24s linear infinite;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding: clamp(48px, 8vw, 112px) clamp(18px, 4vw, 56px) 64px;
  }

  .hero-copy {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #7c5d37;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11px;
    font-weight: 800;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2 {
    color: #171310;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.96;
  }

  h1 {
    font-size: clamp(52px, 9vw, 132px);
  }

  h2 {
    font-size: clamp(40px, 6vw, 82px);
  }

  h3 {
    color: #171310;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .hero-copy > p:not(.eyebrow),
  .editorial p,
  .category-card p,
  .store-footer p {
    max-width: 560px;
    margin-top: 22px;
    color: rgba(23, 19, 16, 0.68);
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid #171310;
    border-radius: 999px;
    padding: 0 24px;
    color: inherit;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  .primary-button {
    background: #171310;
    color: #f6f0e7;
  }

  .secondary-button {
    background: transparent;
  }

  .secondary-button.light {
    border-color: #f6f0e7;
    color: #f6f0e7;
  }

  .hero-media {
    position: relative;
    min-height: 620px;
    overflow: hidden;
    border-radius: 8px;
    background: #e3d5c1;
  }

  .hero-media img,
  .category-card img,
  .editorial img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-note {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    gap: 4px;
    min-width: 190px;
    border-radius: 8px;
    background: #f6f0e7;
    padding: 16px;
    box-shadow: 0 18px 46px rgba(23, 19, 16, 0.18);
  }

  .hero-note span,
  .product-info p {
    color: rgba(23, 19, 16, 0.52);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
    font-weight: 800;
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid rgba(23, 19, 16, 0.12);
  }

  .trust-strip div {
    display: grid;
    gap: 6px;
    padding: 26px clamp(18px, 4vw, 56px);
  }

  .trust-strip div + div {
    border-left: 1px solid rgba(23, 19, 16, 0.12);
  }

  .trust-strip strong {
    font-family: Georgia, serif;
    font-size: 42px;
    line-height: 1;
  }

  .trust-strip span {
    color: rgba(23, 19, 16, 0.62);
  }

  .section-block {
    padding: 84px clamp(18px, 4vw, 56px);
  }

  .section-heading {
    margin-bottom: 34px;
  }

  .section-heading.wide {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .section-heading.wide a {
    color: inherit;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11px;
    font-weight: 800;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .category-card {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    border-radius: 8px;
    background: #171310;
  }

  .category-card::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent 65%);
  }

  .category-card div {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 24px;
  }

  .category-card h3,
  .category-card p {
    color: #fff8ee;
  }

  .category-card p {
    margin-top: 10px;
  }

  .product-section {
    background: #fffaf2;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .product-card {
    overflow: hidden;
    border: 1px solid rgba(23, 19, 16, 0.12);
    border-radius: 8px;
    background: #f6f0e7;
  }

  .product-image {
    position: relative;
    aspect-ratio: 1;
    background: #eadfce;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover img {
    transform: scale(1.04);
  }

  .product-image span {
    position: absolute;
    top: 12px;
    left: 12px;
    border-radius: 999px;
    background: #fffaf2;
    padding: 7px 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 9px;
    font-weight: 800;
  }

  .product-info {
    display: grid;
    gap: 8px;
    padding: 16px;
  }

  .product-info h3 {
    min-height: 58px;
    font-size: 20px;
    line-height: 1.18;
  }

  .product-info div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }

  .product-info button {
    min-height: 38px;
    border: 1px solid #171310;
    border-radius: 999px;
    padding: 0 16px;
    background: #171310;
    color: #fffaf2;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10px;
    font-weight: 800;
  }

  .editorial {
    position: relative;
    display: grid;
    min-height: 620px;
    place-items: end start;
    overflow: hidden;
    padding: clamp(28px, 6vw, 72px);
    color: #f6f0e7;
  }

  .editorial::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.12));
  }

  .editorial img {
    position: absolute;
    inset: 0;
  }

  .editorial div {
    position: relative;
    z-index: 1;
    max-width: 650px;
  }

  .editorial h2,
  .editorial .eyebrow {
    color: #f6f0e7;
  }

  .editorial p {
    color: rgba(246, 240, 231, 0.78);
  }

  .editorial a {
    margin-top: 28px;
  }

  .brand-wall {
    padding: 78px clamp(18px, 4vw, 56px);
    text-align: center;
  }

  .brand-wall div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .brand-wall span {
    border: 1px solid rgba(23, 19, 16, 0.14);
    border-radius: 999px;
    padding: 12px 18px;
    background: #fffaf2;
    font-family: Georgia, serif;
    font-size: clamp(22px, 3vw, 42px);
  }

  .store-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    padding: 42px clamp(18px, 4vw, 56px);
    border-top: 1px solid rgba(23, 19, 16, 0.12);
    background: #171310;
    color: #f6f0e7;
  }

  .store-footer p {
    margin-top: 16px;
    color: rgba(246, 240, 231, 0.68);
  }

  .store-footer > div:last-child {
    display: grid;
    gap: 10px;
    text-align: right;
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-520px);
    }
  }

  @media (max-width: 1024px) {
    .store-header {
      grid-template-columns: 1fr auto;
    }

    nav {
      display: none;
    }

    .hero,
    .category-grid,
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-copy {
      grid-column: 1 / -1;
    }

    .hero-media {
      grid-column: 1 / -1;
      min-height: 520px;
    }
  }

  @media (max-width: 700px) {
    .hero,
    .category-grid,
    .product-grid,
    .trust-strip {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 34px;
    }

    .hero-media,
    .category-card,
    .editorial {
      min-height: 430px;
    }

    .section-heading.wide,
    .store-footer {
      align-items: start;
      flex-direction: column;
    }

    .trust-strip div + div {
      border-left: 0;
      border-top: 1px solid rgba(23, 19, 16, 0.12);
    }

    .store-footer > div:last-child {
      text-align: left;
    }
  }
</style>
